@inherits LayoutComponentBase
@implements IDisposable
@using Client.Components.Shell
@using Client.Components.UI
@using Client.Services
@inject ServerApiClient ServerApi
@inject TeamServerConnection Connection
@inject IConfiguration Config
@inject NavigationManager Nav

<TrinityProviders />

<div class="admin-shell">
    <TopBar Admin="true" Connected="_connected" OnUserLoaded="u => SetSignedInAs(u.Name)" />

    <div class="admin-body">
        <MudPaper Square="true" Elevation="0" Class="pa-3 d-flex flex-column gap-1"
                  Style="width:220px;flex:0 0 220px;border-right:1px solid var(--mud-palette-divider);background:var(--mud-palette-background-gray);">
            <MudText Typo="Typo.overline" Class="mud-text-secondary px-2">ADMIN</MudText>
            <MudNavMenu Color="Color.Primary" Dense="true">
                <MudNavLink Href="campaigns" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Flag">
                    <span class="d-flex align-center">Campaigns<MudSpacer /><MudChip T="string" Size="Size.Small" Class="my-0">@(CampaignCount?.ToString() ?? "–")</MudChip></span>
                </MudNavLink>
                <MudNavLink Href="admin/operators" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Group">
                    <span class="d-flex align-center">Operators<MudSpacer /><MudChip T="string" Size="Size.Small" Class="my-0">@(OperatorCount?.ToString() ?? "–")</MudChip></span>
                </MudNavLink>
            </MudNavMenu>
            <MudText Typo="Typo.caption" Class="mud-text-secondary px-2 mt-2">Only admins can see this page. Operators reach the workspace only.</MudText>
        </MudPaper>

        <main class="admin-main">
            <CascadingValue Value="this">@Body</CascadingValue>
        </main>
    </div>

    <StatusBar Connected="_connected" Items="StatusItems" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _connected;

    public int? CampaignCount { get; private set; }
    public int? OperatorCount { get; private set; }
    public string? SignedInAs { get; private set; }

    private IEnumerable<string> StatusItems => SignedInAs is null ? [] : [$"signed in as {SignedInAs}"];

    public void SetCounts(int? campaigns = null, int? operators = null)
    {
        CampaignCount = campaigns ?? CampaignCount;
        OperatorCount = operators ?? OperatorCount;
        StateHasChanged();
    }

    public void SetSignedInAs(string name)
    {
        SignedInAs = name;
        StateHasChanged();
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    protected override async Task OnInitializedAsync()
    {
        if (Connection.BaseAddress is null && Config["TeamServer:BaseUrl"] is { Length: > 0 } baseUrl)
        {
            Connection.Configure(baseUrl);
        }

        try
        {
            _connected = await ServerApi.GetServerStatusAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            _connected = false;
        }
    }
}
