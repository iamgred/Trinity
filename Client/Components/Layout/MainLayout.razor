@inherits LayoutComponentBase
@namespace Client.Components.Layout
@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@using Client.Components.Shell
@using Client.Components.UI

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudDialogProvider />
<MudSnackbarProvider />

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</HeadContent>

<CascadingValue Value="_workspaceState">
<div class="trinity c2-shell">

    <header class="c2-topbar-primary">
        <a class="c2-brand" href="/agents">
            <span class="c2-brand-badge"><img src="/images/Trinity_Head.svg" class="c2-brand-icon" alt="" /></span>
            <span class="c2-brand-name">TRINITY</span>
        </a>
        <div class="c2-primary-right">
            <span class="c2-server-pill @(_serverOnline ? "c2-server-online" : "c2-server-offline")">
                <span class="c2-server-dot"></span>
                teamserver @(Config["TeamServer:BaseUrl"]?.Replace("http://","").Replace("https://","") ?? "—")
            </span>
            <span class="c2-operator">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span class="c2-operator-name">Administrator</span>
                <span class="c2-role">operator</span>
            </span>
            <a class="c2-logout-btn" href="/login" title="Logout">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            </a>
        </div>
    </header>

    <nav class="c2-nav-bar">
        <button class="@(_workspaceState.ListenersOpen ? "c2-nav-item active" : "c2-nav-item")"
                @onclick="() => { if (_workspaceState.ListenersOpen) _workspaceState.CloseListeners(); else _workspaceState.OpenListeners(); }">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>
            Listeners
        </button>
        <button class="@AgentsNavClass("graph")" @onclick='() => NavigateToAgentView("graph")'>
            <svg class="c2-ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
            Pivot Graph
        </button>
        <button class="@AgentsNavClass("table")" @onclick='() => NavigateToAgentView("table")'>
            <svg class="c2-ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></svg>
            Agents
        </button>
        <span class="c2-nav-divider"></span>
        <NavLink class="c2-nav-item" href="/logs" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></svg>
            Event Log
        </NavLink>
        <NavLink class="c2-nav-item" href="/loot" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
            Loot
        </NavLink>
        <button class="@(_workspaceState.ArmouryOpen ? "c2-nav-item active" : "c2-nav-item")"
                @onclick="() => { if (_workspaceState.ArmouryOpen) _workspaceState.CloseArmoury(); else _workspaceState.OpenArmoury(); }">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            Armoury
        </button>
        <span class="c2-nav-divider"></span>
        <NavLink class="c2-nav-item c2-nav-cta" href="/payloads" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
            Generate Payload
        </NavLink>
        <div class="c2-nav-spacer"></div>
        <div class="c2-search-box">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input class="c2-search-input" placeholder="Filter agents by host, user, id…" />
        </div>
    </nav>

    <div class="c2-workspace">@Body</div>

    @if (_workspaceState.PanelVisible)
    {
    <div class="c2-bottom-panel" id="bottom-panel" style="height: @(_bottomH)px;">
        <div class="c2-panel-draghandle" id="bottom-resizer"><span></span><span></span><span></span></div>
        <div class="c2-panel-tabs">
            @if (_workspaceState.EventLogVisible)
            {
            <button class="c2-panel-tab @(_workspaceState.ActiveBottomTab == 0 ? "active" : "")" @onclick="() => SetBottomTab(0)">
                Event Log
                <span class="c2-tab-x" @onclick:stopPropagation="true"
                      @onclick="() => _workspaceState.CloseEventLog()"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span>
            </button>
            }
            @foreach (var (term, ti) in _workspaceState.OpenAgentTerminals.Select((a, i) => (a, i)))
            {
                var tabIdx = ti + 1;
                var t = term;
                <button class="c2-panel-tab @(_workspaceState.ActiveBottomTab == tabIdx ? "active" : "")"
                        @onclick="() => SetBottomTab(tabIdx)">
                    @(t.username ?? $"agent {t.agentID}")
                    <span class="c2-tab-x" @onclick:stopPropagation="true"
                          @onclick="() => _workspaceState.CloseAgentTerminal(t.agentID)"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span>
                </button>
            }
            @if (_workspaceState.ArmouryOpen)
            {
                <button class="c2-panel-tab @(_workspaceState.ActiveBottomTab == _workspaceState.ArmouryTabIndex ? "active" : "")"
                        @onclick="() => SetBottomTab(_workspaceState.ArmouryTabIndex)">
                    Armoury
                    <span class="c2-tab-x" @onclick:stopPropagation="true"
                          @onclick="() => _workspaceState.CloseArmoury()"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span>
                </button>
            }
            @if (_workspaceState.ListenersOpen)
            {
                <button class="c2-panel-tab @(_workspaceState.ActiveBottomTab == _workspaceState.ListenersTabIndex ? "active" : "")"
                        @onclick="() => SetBottomTab(_workspaceState.ListenersTabIndex)">
                    Listeners
                    <span class="c2-tab-x" @onclick:stopPropagation="true"
                          @onclick="() => _workspaceState.CloseListeners()"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span>
                </button>
            }
        </div>
        <div class="c2-panel-body">
            @if (_workspaceState.EventLogVisible && _workspaceState.ActiveBottomTab == 0)
            {
                @if (_events.Count == 0)
                {
                    <div style="color:#6c6c74;font-family:var(--c2-mono);font-size:12px;padding:2px 18px;">No events yet.</div>
                }
                else
                {
                    @foreach (var ev in _events)
                    {
                        <div class="ev-row">
                            <span class="ev-stamp">@ev.Stamp</span>
                            <span class="@SevClass(ev.Level)">[@ev.Level]</span>
                            <span class="ev-msg">@ev.Message</span>
                        </div>
                    }
                }
            }
            @foreach (var (term, ti) in _workspaceState.OpenAgentTerminals.Select((a, i) => (a, i)))
            {
                var tabIdx = ti + 1;
                var t = term;
                <div @key="t.agentID"
                     class="@(_workspaceState.ActiveBottomTab == tabIdx ? "agent-term-container" : "agent-term-container agent-term-container--hidden")">
                    <AgentTerminal AgentId="@t.agentID"
                                   OnClose="() => _workspaceState.CloseAgentTerminal(t.agentID)" />
                </div>
            }
            @if (_workspaceState.ArmouryOpen)
            {
                <div class="@(_workspaceState.ActiveBottomTab == _workspaceState.ArmouryTabIndex ? "agent-term-container" : "agent-term-container agent-term-container--hidden")">
                    <ArmouryPanel />
                </div>
            }
            @if (_workspaceState.ListenersOpen)
            {
                <div class="@(_workspaceState.ActiveBottomTab == _workspaceState.ListenersTabIndex ? "agent-term-container" : "agent-term-container agent-term-container--hidden")">
                    <ListenersPanel />
                </div>
            }
        </div>
    </div>
    }

    <footer class="c2-status-bar">
        <span class="c2-conn @(_serverOnline ? "c2-ok" : "c2-err")"><span class="c2-conn-dot"></span>@(_serverOnline ? "Connected" : "Disconnected")</span>
        <span>0 agents</span>
        <span>0 SMB peers</span>
        <span>0 listeners</span>
        <div class="c2-status-spacer"></div>
        @if (!_workspaceState.EventLogVisible)
        {
            <button class="c2-statusbar-toggle" @onclick="() => _workspaceState.OpenEventLog()" title="Show Event Log">
                Event Log
            </button>
        }
        <span class="c2-status-version">Trinity C2 · v2.0</span>
    </footer>

</div>
</CascadingValue>