@inherits LayoutComponentBase
@using Client.Components.Shell
@using Client.Components.UI
@using Client.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager Navigation
@inject ProtectedSessionStorage Session
@inject TeamServerConnection Connection
@inject IConfiguration Config

<TrinityProviders />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Primary" Style="border-bottom:1px solid var(--mud-palette-divider);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width:220px;">
            <img src="img/trinity_logo.png" alt="Trinity logo" style="height:40px;width:auto;" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Style="font-weight:700;letter-spacing:0.08em;line-height:1.1;">TRINITY</MudText>
                <MudText Typo="Typo.caption" Style="line-height:1;">Command &amp; Control Dashboard</MudText>
            </MudStack>
        </MudStack>

        <MudSpacer />

        <MudTextField T="string" Placeholder="Search..." Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Style="max-width:380px;background-color:var(--mud-palette-surface);border-radius:4px;" />

        <MudSpacer />

        <MudTooltip Text="Notifications">
            <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" />
        </MudTooltip>
        <MudTooltip Text="Settings">
            <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" Href="settings" />
        </MudTooltip>

        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" OpenChanged="OnUserMenuOpenChanged">
            <ActivatorContent>
                <MudButton Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AccountCircle" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                           Style="text-transform:none;">
                    <MudStack Spacing="0" AlignItems="AlignItems.Start">
                        <MudText Typo="Typo.body2" Style="font-weight:600;line-height:1.2;">@_current.Name</MudText>
                        <MudText Typo="Typo.caption" Style="line-height:1;">@_current.Role</MudText>
                    </MudStack>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-4 py-3" Style="min-width:240px;">
                    <MudAvatar Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.Person" /></MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body1" Style="font-weight:600;">@_current.Name</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_current.Role</MudText>
                    </MudStack>
                </MudStack>
                <MudDivider />

                @if (!_switchMode)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Logout</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.SwitchAccount" AutoClose="false" OnClick="() => _switchMode = true">Switch User</MudMenuItem>
                }
                else
                {
                    <MudText Typo="Typo.overline" Class="px-4 pt-2">Switch account</MudText>
                    @if (_accounts.Any())
                    {
                        @foreach (var acc in _accounts)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="() => SwitchTo(acc)">
                                @acc.Name <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary">@acc.Role</MudText>
                            </MudMenuItem>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error" Class="px-4 py-2">No other accounts signed in on this device.</MudText>
                    }
                    <MudMenuItem Icon="@Icons.Material.Filled.ArrowBack" AutoClose="false" OnClick="() => _switchMode = false">Back</MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always" Elevation="0" Width="220px"
               Style="border-right:1px solid var(--mud-palette-divider);">
        <MudNavMenu Margin="Margin.Normal" Color="Color.Primary" Bordered="true">
            @foreach (var item in NavItems)
            {
                <MudNavLink Href="@item.Href" Match="NavLinkMatch.Prefix" Icon="@item.Icon">@item.Label</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">@Body</MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _switchMode;

    private void OnUserMenuOpenChanged(bool open)
    {
        if (!open) _switchMode = false;
    }

    private async Task Logout()
    {
        _switchMode = false;
        await Session.DeleteAsync(ShellUser.StorageKey);
        Navigation.NavigateTo("/login");
    }

    protected override void OnInitialized()
    {
        if (Connection.BaseAddress is null && Config["TeamServer:BaseUrl"] is { Length: > 0 } baseUrl)
        {
            Connection.Configure(baseUrl);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var stored = await Session.GetAsync<ShellUser>(ShellUser.StorageKey);
            if (stored is { Success: true, Value: { } user })
            {
                _current = new(user.Name, user.IsAdmin ? "Admin" : "Operator");
                StateHasChanged();
            }
        }
        catch (Exception)
        {
        }
    }

    private record Account(string Name, string Role);

    private Account _current = new("Not signed in", "");
    private readonly List<Account> _accounts = new();

    private void SwitchTo(Account acc)
    {
        _accounts.Remove(acc);
        _accounts.Add(_current);
        _current = acc;
        _switchMode = false;
    }

    private record Nav(string Label, string Href, string Icon);
    private readonly Nav[] NavItems =
    [
        new("Dashboard", "dashboard", Icons.Material.Filled.Home),
        new("Deployment", "deployment", Icons.Material.Filled.Dns),
        new("Clients", "clients", Icons.Material.Filled.Person),
        new("Campaigns", "campaigns", Icons.Material.Filled.Work),
        new("Tasks", "tasks", Icons.Material.Filled.FormatListBulleted),
        new("Files", "files", Icons.Material.Filled.Folder),
        new("Logs", "logs", Icons.Material.Filled.Article),
        new("Reports", "reports", Icons.Material.Filled.BarChart),
        new("Settings", "settings", Icons.Material.Filled.Settings),
    ];
}
