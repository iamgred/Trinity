@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="trinity-shell">

    <header class="trinity-header">
        <div class="header-brand">
            <img class="brand-logo" src="img/trinity_logo.png" alt="Trinity logo" />
            <div class="brand-text">
                <span class="brand-title">TRINITY</span>
                <span class="brand-sub">Command &amp; Control Dashboard</span>
            </div>
        </div>

        <div class="header-search">
            <svg viewBox="0 0 24 24"><path d="M15.5,14h-0.79l-0.28,-0.27C15.41,12.59 16,11.11 16,9.5 16,5.91 13.09,3 9.5,3S3,5.91 3,9.5 5.91,16 9.5,16c1.61,0 3.09,-0.59 4.23,-1.57l0.27,0.28v0.79l5,4.99L20.49,19l-4.99,-5zM9.5,14C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14z" /></svg>
            <input type="text" placeholder="Search..." />
        </div>

        <div class="header-actions">
            <button type="button" class="icon-btn" title="Notifications">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18,8A6,6 0 0,0 6,8c0,7 -3,9 -3,9h18s-3,-2 -3,-9" /><path d="M13.73,21a2,2 0 0,1 -3.46,0" /></svg>
                <span class="notif-badge">3</span>
            </button>
            <button type="button" class="icon-btn" title="Settings">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4,15a1.65,1.65 0 0,0 0.33,1.82l0.06,0.06a2,2 0 1,1 -2.83,2.83l-0.06,-0.06a1.65,1.65 0 0,0 -1.82,-0.33 1.65,1.65 0 0,0 -1,1.51L14,21a2,2 0 0,1 -4,0v-0.09A1.65,1.65 0 0,0 9,19.4a1.65,1.65 0 0,0 -1.82,0.33l-0.06,0.06a2,2 0 1,1 -2.83,-2.83l0.06,-0.06a1.65,1.65 0 0,0 0.33,-1.82 1.65,1.65 0 0,0 -1.51,-1L3,14a2,2 0 0,1 0,-4h0.09A1.65,1.65 0 0,0 4.6,9a1.65,1.65 0 0,0 -0.33,-1.82l-0.06,-0.06a2,2 0 1,1 2.83,-2.83l0.06,0.06a1.65,1.65 0 0,0 1.82,0.33L9,4.6a1.65,1.65 0 0,0 1,-1.51L10,3a2,2 0 0,1 4,0v0.09a1.65,1.65 0 0,0 1,1.51 1.65,1.65 0 0,0 1.82,-0.33l0.06,-0.06a2,2 0 1,1 2.83,2.83l-0.06,0.06a1.65,1.65 0 0,0 -0.33,1.82V9a1.65,1.65 0 0,0 1.51,1H21a2,2 0 0,1 0,4h-0.09a1.65,1.65 0 0,0 -1.51,1z" /></svg>
            </button>

            <div class="user-menu">
                <button type="button" class="user-trigger" @onclick="ToggleUserMenu">
                    <span class="user-avatar">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z" /></svg>
                    </span>
                    <span class="user-block">
                        <span class="user-name">@_current.Name</span>
                        <span class="user-role">@_current.Role</span>
                    </span>
                    <svg class="user-caret" viewBox="0 0 24 24" fill="currentColor"><path d="M7,10l5,5 5,-5z" /></svg>
                </button>

                @if (_userMenuOpen)
                {
                    <div class="menu-backdrop" @onclick="CloseUserMenu"></div>
                    <div class="user-dropdown">
                        <div class="dropdown-head">
                            <span class="dropdown-avatar">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z" /></svg>
                            </span>
                            <div class="dropdown-user">
                                <span class="dropdown-name">@_current.Name</span>
                                <span class="dropdown-role">@_current.Role</span>
                            </div>
                        </div>
                        <div class="dropdown-divider"></div>

                        @if (!_switchMode)
                        {
                            <button type="button" class="dropdown-btn" @onclick="Logout">Logout</button>
                            <button type="button" class="dropdown-btn" @onclick="() => _switchMode = true">Switch User</button>
                        }
                        else
                        {
                            <div class="switch-title">Switch account</div>
                            @if (_accounts.Any())
                            {
                                @foreach (var acc in _accounts)
                                {
                                    <button type="button" class="account-row" @onclick="() => SwitchTo(acc)">
                                        <span class="account-avatar">
                                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z" /></svg>
                                        </span>
                                        <span class="account-text">
                                            <span class="account-name">@acc.Name</span>
                                            <span class="account-role">@acc.Role</span>
                                        </span>
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="switch-error">No other accounts signed in on this device.</div>
                            }
                            <button type="button" class="dropdown-btn back-btn" @onclick="() => _switchMode = false">Back</button>
                        }
                    </div>
                }
            </div>
        </div>
    </header>

    <div class="trinity-body">
        <aside class="trinity-sidebar">
            <nav>
                @foreach (var item in NavItems)
                {
                    <NavLink href="@item.Href" class="sidebar-link" Match="NavLinkMatch.Prefix">
                        <span class="sidebar-ico">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                @((MarkupString)item.IconSvg)
                            </svg>
                        </span>
                        <span class="sidebar-label">@item.Label</span>
                    </NavLink>
                }
            </nav>
        </aside>
        <main class="trinity-content">@Body</main>
    </div>

</div>

@code {
    private bool _userMenuOpen;
    private bool _switchMode;

    private void ToggleUserMenu()
    {
        _userMenuOpen = !_userMenuOpen;
        if (!_userMenuOpen) _switchMode = false;
    }

    private void CloseUserMenu()
    {
        _userMenuOpen = false;
        _switchMode = false;
    }

    private void Logout()
    {
        CloseUserMenu();
        Navigation.NavigateTo("/login");
    }

    private record Account(string Name, string Role);

    private Account _current = new("User Name", "Administrator");
    private readonly List<Account> _accounts = new();

    private void SwitchTo(Account acc)
    {
        _accounts.Remove(acc);
        _accounts.Add(_current);
        _current = acc;
        CloseUserMenu();
    }

    private record Nav(string Label, string Href, string IconSvg);
    private Nav[] NavItems = new Nav[]
    {
        new("Dashboard", "dashboard", "<path d='M3 10.5L12 3l9 7.5'/><path d='M5 9.5V21h14V9.5'/><path d='M9 21v-6h6v6'/>"),
        new("Deployment", "deployment", "<rect x='3' y='4' width='18' height='6' rx='1'/><rect x='3' y='14' width='18' height='6' rx='1'/><path d='M7 7h.01M7 17h.01'/>"),
        new("Clients", "clients", "<circle cx='12' cy='8' r='4'/><path d='M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1'/>"),
        new("Campaigns", "campaigns", "<rect x='3' y='7' width='18' height='13' rx='2'/><path d='M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'/>"),
        new("Tasks", "tasks", "<circle cx='4' cy='6' r='1'/><circle cx='4' cy='12' r='1'/><circle cx='4' cy='18' r='1'/><line x1='9' y1='6' x2='21' y2='6'/><line x1='9' y1='12' x2='21' y2='12'/><line x1='9' y1='18' x2='21' y2='18'/>"),
        new("Files", "files", "<path d='M3 7a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/>"),
        new("Logs", "logs", "<path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><path d='M14 2v6h6'/><path d='M8 13h8M8 17h8M8 9h2'/>"),
        new("Reports", "reports", "<path d='M18 20V10M12 20V4M6 20v-6'/>"),
        new("Settings", "settings", "<circle cx='12' cy='12' r='3'/><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z'/>")
    };
}
