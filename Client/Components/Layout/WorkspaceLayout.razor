@inherits LayoutComponentBase
@namespace Client.Components.Layout
@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@using Client.Components.Shell

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="_workspaceState">
<div class="trinity c2-shell">

    <header class="c2-topbar-primary">
        <div class="c2-primary-left">
            <a class="c2-brand" href="/agents">
              <img src="/images/Trinity_Head.svg" class="c2-brand-icon" alt="" />
              <img src="/images/Trinity_Name.svg" class="c2-brand-name" alt="TRINITY" />
            </a>
        </div>
        <div class="c2-primary-right">
            <span class="c2-server-pill @(_serverOnline ? "c2-server-online" : "c2-server-offline")">
                <span class="c2-server-dot"></span>
                teamserver @(Config["TeamServer:BaseUrl"]?.Replace("http://","").Replace("https://","") ?? "—")
            </span>
            <span class="c2-operator">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" style="opacity:0.75"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                Administrator <span class="c2-role">operator</span>
            </span>
            <a class="c2-logout-btn" href="/login" title="Logout">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
            </a>
        </div>
    </header>

    <nav class="c2-nav-bar">
        <NavLink class="c2-nav-item" href="/listeners" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="currentColor"><path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/></svg>
            Listeners
        </NavLink>
        <NavLink class="c2-nav-item" href="/pivot" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="currentColor"><path d="M22 11V3h-7v3H9V3H2v8h7V8h2v10h4v3h7v-8h-7v3h-2V8h2v3z"/></svg>
            Pivot Graph
        </NavLink>
        <NavLink class="c2-nav-item" href="/agents" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="currentColor"><path d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/></svg>
            Agents
        </NavLink>
        <NavLink class="c2-nav-item" href="/logs" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
            Event Log
        </NavLink>
        <NavLink class="c2-nav-item" href="/loot" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/></svg>
            Loot
        </NavLink>
        <NavLink class="c2-nav-item" href="/armoury" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
            Armoury
        </NavLink>
        <NavLink class="c2-nav-item" href="/payloads" Match="NavLinkMatch.Prefix">
            <svg class="c2-ni" viewBox="0 0 24 24" fill="currentColor"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>
            Generate Payload
        </NavLink>
        <div class="c2-nav-spacer"></div>
        <div class="c2-search-box">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" style="color:rgba(255,255,255,0.35);flex-shrink:0"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <input class="c2-search-input" placeholder="Filter agents by host, user, id..." />
        </div>
    </nav>

    <div class="c2-workspace">@Body</div>

    <div class="c2-bottom-panel" id="bottom-panel" style="height: @(_bottomH)px;">
        <div class="c2-panel-draghandle"></div>
        <div class="c2-panel-tabs">
            <button class="c2-panel-tab @(_bottomTab == 0 ? "active" : "")" @onclick="() => SetBottomTab(0)">
                Event Log <span class="c2-tab-x">×</span>
            </button>
            <button class="c2-panel-tab @(_bottomTab == 1 ? "active" : "")" @onclick="() => SetBottomTab(1)">
                Terminal <span class="c2-tab-x">×</span>
            </button>
        </div>
        <div class="c2-panel-body">
            @if (_bottomTab == 0)
            {
                @if (_events.Count == 0)
                {
                    <div style="color:var(--text-muted);font-size:12px;padding:12px 0;">No events yet.</div>
                }
                else
                {
                    @foreach (var ev in _events)
                    {
                        <div class="ev-row">
                            <span class="ev-stamp">@ev.Stamp</span>
                            <span class="@SevClass(ev.Level)">[@ev.Level]</span>
                            <span class="ev-msg">@ev.Message</span>
                        </div>
                    }
                }
            }
            @if (_bottomTab == 1)
            {
                <div class="term-output" style="white-space: pre-wrap; overflow-y: auto;">@((MarkupString)_termHtml)</div>
                <div class="term-input-row">
                    <span class="term-prompt">@PromptText</span>
                    <input class="term-input" type="text" @bind="_termInput" @bind:event="oninput" @onkeydown="HandleTermKey" placeholder="type a command..." />
                </div>
            }
        </div>
    </div>

    <footer class="c2-status-bar">
        <span class="@(_serverOnline ? "c2-ok" : "c2-err")">@(_serverOnline ? "● Connected" : "● Disconnected")</span>
        <span>0 agents</span>
        <span>0 SMB peers</span>
        <span>0 listeners</span>
        <div class="c2-status-spacer"></div>
        <span class="c2-status-version">Trinity C2 · v2.0</span>
    </footer>

</div>
</CascadingValue>