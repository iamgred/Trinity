@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Text.Json
@using Client.Components.Shell
@using Client.Components.UI
@using Client.Services
@inject AgentApiClient AgentApi
@inject ListenerApiClient ListenerApi
@inject ServerApiClient ServerApi
@inject TeamServerConnection Connection
@inject IConfiguration Config
@inject IHttpClientFactory HttpFactory
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage Session

<TrinityProviders />

<CascadingValue Value="State">
    <div class="ws-shell">
        <TopBar Connected="State.Connected" />
        <NavRow />

        <section class="ws-agents" style="height:@(State.AgentsPanelHeight)px">
            <AgentsPanel />
        </section>

        <div class="ws-splitter" title="Drag to resize" @onpointerdown="StartResize">
            <i></i><i></i><i></i>
        </div>

        <BottomTabs />

        <main class="ws-page">@Body</main>

        <StatusBar Connected="State.Connected" Items="StatusItems" />

        @if (_resizing)
        {
            <div class="ws-resize-capture" @onpointermove="Resize" @onpointerup="StopResize" @onpointerleave="StopResize"></div>
        }
    </div>
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly WorkspaceState State = new();
    private readonly CancellationTokenSource _stop = new();
    private bool _resizing;
    private double _resizeStartY;
    private int _resizeStartHeight;

    private IEnumerable<string> StatusItems =>
    [
        $"{State.Agents.Count} agent{(State.Agents.Count == 1 ? "" : "s")}",
        $"{State.SmbPeerCount} SMB peer{(State.SmbPeerCount == 1 ? "" : "s")}",
        $"{State.ListenerCount} listener{(State.ListenerCount == 1 ? "" : "s")}",
    ];

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;

        if (Connection.BaseAddress is null && Config["TeamServer:BaseUrl"] is { Length: > 0 } baseUrl)
        {
            Connection.Configure(baseUrl);
        }

        await RefreshAsync();
        _ = PollAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private EventLogFeed? _events;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Config["TeamServer:BaseUrl"] is not { Length: > 0 } baseUrl)
        {
            return;
        }

        ShellUser? user = null;
        try
        {
            var stored = await Session.GetAsync<ShellUser>(ShellUser.StorageKey);
            user = stored.Success ? stored.Value : null;
        }
        catch (Exception)
        {
        }

        if (user is null)
        {
            return;
        }

        _events = new EventLogFeed(State, HttpFactory, baseUrl);
        await _events.StartAsync(user);
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        var tick = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                tick++;
                await RefreshAgentsAsync();
                if (tick % 3 == 0)
                {
                    await RefreshServerAsync();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        await RefreshServerAsync();
        await RefreshAgentsAsync();
    }

    private async Task RefreshAgentsAsync()
    {
        try
        {
            State.Agents = await AgentApi.GetAgentsAsync(_stop.Token);
            State.AgentsError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException or TaskCanceledException)
        {
            State.AgentsError = ServerDown.Is(ex) ? ServerDown.Message : $"Couldn't load the agents: {ex.Message}";
        }
    }

    private async Task RefreshServerAsync()
    {
        try
        {
            State.Connected = await ServerApi.GetServerStatusAsync(_stop.Token);
            State.ListenerCount = (await ListenerApi.GetListenersAsync(_stop.Token)).Count;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or JsonException or TaskCanceledException)
        {
            State.Connected = false;
        }
    }

    private void StartResize(PointerEventArgs e)
    {
        _resizing = true;
        _resizeStartY = e.ClientY;
        _resizeStartHeight = State.AgentsPanelHeight;
    }

    private void Resize(PointerEventArgs e) =>
        State.AgentsPanelHeight = Math.Clamp(_resizeStartHeight + (int)(e.ClientY - _resizeStartY), 120, 640);

    private void StopResize() => _resizing = false;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        _stop.Cancel();
        _stop.Dispose();
        if (_events is not null)
        {
            await _events.DisposeAsync();
        }
    }
}
