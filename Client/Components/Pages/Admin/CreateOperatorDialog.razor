@using System.Net.Http.Json
@using Client.Services
@using Campaign = Trinity.Shared.Models.Campaign
@using Operator = Trinity.Shared.Models.Operator
@using Admin = Trinity.Shared.Models.Admin
@inject OperatorService OperatorService
@inject AdminService AdminService
@inject IHttpClientFactory HttpFactory

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Title</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Subtitle</MudText>
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (Mode != OperatorDialogMode.ResetPassword)
            {
                <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" Immediate="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" autocomplete="off" />
            }

            @if (Mode != OperatorDialogMode.Edit)
            {
                <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined" Immediate="true" InputType="InputType.Password"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Key" autocomplete="new-password" />
                <MudTextField @bind-Value="_confirm" Label="Confirm Password" Variant="Variant.Outlined" Immediate="true" InputType="InputType.Password"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Key" autocomplete="new-password" />
            }

            @if (Mode == OperatorDialogMode.Create)
            {
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">Role</MudText>
                    <MudToggleGroup T="string" @bind-Value="_role" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="true">
                        @foreach (var role in Roles)
                        {
                            <MudToggleItem Value="@role" Text="@RoleLabel(role)" />
                        }
                    </MudToggleGroup>
                </div>
            }

            @if (Mode != OperatorDialogMode.ResetPassword && _role == "operator")
            {
                <MudSelect T="int" Label="Campaigns" Variant="Variant.Outlined" MultiSelection="true"
                           SelectedValues="_campaignIds" SelectedValuesChanged="v => _campaignIds = v.ToHashSet()"
                           MultiSelectionTextFunc="CampaignText"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Flag"
                           Disabled="Campaigns.Count == 0" HelperText="@(Campaigns.Count == 0 ? "No campaigns yet" : null)">
                    @foreach (var campaign in Campaigns)
                    {
                        <MudSelectItem T="int" Value="@campaign.ID">@campaign.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mr-auto ml-2">Share the password with the operator directly.</MudText>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SubmitAsync">@SubmitLabel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public OperatorDialogMode Mode { get; set; }
    [Parameter] public OperatorRow? Existing { get; set; }
    [Parameter] public IReadOnlyList<Campaign> Campaigns { get; set; } = [];
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private static readonly IReadOnlyList<string> Roles = ["operator", "admin"];

    private string _username = "";
    private string _password = "";
    private string _confirm = "";
    private string _role = "operator";
    private HashSet<int> _campaignIds = [];
    private bool _busy;
    private string? _error;

    private string Title => Mode switch
    {
        OperatorDialogMode.Edit => "Edit Operator",
        OperatorDialogMode.ResetPassword => "Reset Password",
        _ => "Create Operator",
    };

    private string Subtitle => Mode switch
    {
        OperatorDialogMode.Edit => $"Change {Existing?.Username}'s name and campaigns",
        OperatorDialogMode.ResetPassword => $"Set a new password for {Existing?.Username}",
        _ => "The operator signs in with this username and password",
    };

    private string SubmitLabel => _busy ? "Saving…" : Mode switch
    {
        OperatorDialogMode.Edit => "Save Changes",
        OperatorDialogMode.ResetPassword => "Reset Password",
        _ => "Create Operator",
    };

    private static string RoleLabel(string role) => role == "admin" ? "Admin" : "Operator";

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _username = Existing.Username;
            _role = Existing.IsAdmin ? "admin" : "operator";
            _campaignIds = Existing.CampaignIds.ToHashSet();
        }
    }

    private string CampaignText(IReadOnlyList<string> ids) =>
        string.Join(", ", Campaigns.Where(c => _campaignIds.Contains(c.ID)).Select(c => c.Name));

    private async Task SubmitAsync()
    {
        _error = Validate();
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            _error = Mode switch
            {
                OperatorDialogMode.Edit => await SaveEditAsync(),
                OperatorDialogMode.ResetPassword => await SavePasswordAsync(),
                _ => await CreateAsync(),
            };

            if (_error is null)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (HttpRequestException e)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private string? Validate()
    {
        if (Mode != OperatorDialogMode.ResetPassword && string.IsNullOrWhiteSpace(_username))
        {
            return "Enter a username.";
        }

        if (Mode != OperatorDialogMode.Edit)
        {
            if (string.IsNullOrEmpty(_password))
            {
                return "Enter a password.";
            }

            if (_password != _confirm)
            {
                return "The passwords do not match.";
            }
        }

        return null;
    }

    private async Task<string?> CreateAsync()
    {
        var username = _username.Trim();
        if (_role == "admin")
        {
            return await AdminService.CreateAsync(new Admin { Username = username, Password = _password }) ? null : "The team server refused the new admin.";
        }

        if (!await OperatorService.CreateAsync(new Operator { Username = username, Password = _password }))
        {
            return "The team server refused the new operator.";
        }

        var created = (await OperatorService.GetAllAsync()).FirstOrDefault(o => o.Username == username);
        return created is null ? "The operator was created but could not be found to assign campaigns." : await SyncCampaignsAsync(created.ID, []);
    }

    private async Task<string?> SaveEditAsync()
    {
        if (Existing is null)
        {
            return "Nothing to edit.";
        }

        var http = HttpFactory.CreateClient("TeamServer");
        var username = _username.Trim();
        var response = Existing.IsAdmin
            ? await http.PutAsJsonAsync($"/api/v1/admins/{Existing.Id}", new Admin { ID = Existing.Id, Username = username, Password = Existing.Password })
            : await http.PutAsJsonAsync($"/api/v1/operators/{Existing.Id}", new Operator { ID = Existing.Id, Username = username, Password = Existing.Password });
        if (!response.IsSuccessStatusCode)
        {
            return $"The team server refused the change ({(int)response.StatusCode}).";
        }

        return Existing.IsAdmin ? null : await SyncCampaignsAsync(Existing.Id, Existing.CampaignIds);
    }

    private async Task<string?> SavePasswordAsync()
    {
        if (Existing is null)
        {
            return "Nothing to reset.";
        }

        var http = HttpFactory.CreateClient("TeamServer");
        var response = Existing.IsAdmin
            ? await http.PutAsJsonAsync($"/api/v1/admins/{Existing.Id}", new Admin { ID = Existing.Id, Username = Existing.Username, Password = _password })
            : await http.PutAsJsonAsync($"/api/v1/operators/{Existing.Id}", new Operator { ID = Existing.Id, Username = Existing.Username, Password = _password });
        return response.IsSuccessStatusCode ? null : $"The team server refused the new password ({(int)response.StatusCode}).";
    }

    private async Task<string?> SyncCampaignsAsync(int operatorId, IReadOnlyCollection<int> before)
    {
        var http = HttpFactory.CreateClient("TeamServer");
        foreach (var id in _campaignIds.Except(before))
        {
            if (!(await http.PostAsync($"/api/v1/campaigns/{id}/operators/{operatorId}", null)).IsSuccessStatusCode)
            {
                return "Saved, but a campaign could not be assigned.";
            }
        }

        foreach (var id in before.Except(_campaignIds))
        {
            if (!(await http.DeleteAsync($"/api/v1/campaigns/{id}/operators/{operatorId}")).IsSuccessStatusCode)
            {
                return "Saved, but a campaign could not be unassigned.";
            }
        }

        return null;
    }
}
