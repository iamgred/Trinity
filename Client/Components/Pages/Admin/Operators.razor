@page "/admin/operators"
@layout AdminLayout
@using System.Net.Http.Json
@using System.Text.Json
@using Client.Components.Layout
@using Client.Components.UI
@using Client.Services
@using Campaign = Trinity.Shared.Models.Campaign
@using Operator = Trinity.Shared.Models.Operator
@inject OperatorService OperatorService
@inject AdminService AdminService
@inject CampaignService CampaignService
@inject IHttpClientFactory HttpFactory
@inject IDialogService DialogService

<PageTitle>Trinity · Operators</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Style="font-weight:700;">Operators</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Admins create every account. There is no self-registration.</MudText>
    </MudStack>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => OpenAsync(OperatorDialogMode.Create)">Create Operator</MudButton>
</MudStack>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@_error</MudAlert>
}

<MudPaper Outlined="true">
    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
        <thead><tr><th>id</th><th>username</th><th>role</th><th>campaigns</th><th>last login</th></tr></thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="5" class="mud-text-secondary" style="text-align:center;">@(_loading ? "Loading accounts…" : "No accounts yet.")</td></tr>
            }
            @foreach (var row in _rows)
            {
                <tr class="@(row == _selected ? "t-row-selected" : null)" style="cursor:pointer;" @onclick="() => Select(row)">
                    <td>@row.Id</td>
                    <td>@row.Username</td>
                    <td><StatusPill Text="@(row.IsAdmin ? "admin" : "operator")" Tone="@(row.IsAdmin ? "orange" : "blue")" /></td>
                    <td>@CampaignNames(row)</td>
                    <td>@(row.LastLogin is { } login && login > DateTime.MinValue ? login.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

<MudStack Row="true" Spacing="2" Class="mt-3">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" Disabled="_selected is null" OnClick="() => OpenAsync(OperatorDialogMode.Edit)">Edit</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Key" Disabled="_selected is null" OnClick="() => OpenAsync(OperatorDialogMode.ResetPassword)">Reset Password</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" Disabled="_selected is null" OnClick="RemoveAsync">@(_confirmRemove ? $"Remove {_selected?.Username}?" : "Remove")</MudButton>
</MudStack>

@code {
    [CascadingParameter] private AdminLayout Layout { get; set; } = default!;

    private List<OperatorRow> _rows = [];
    private List<Campaign> _campaigns = [];
    private OperatorRow? _selected;
    private bool _confirmRemove;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("TeamServer");
            _campaigns = await CampaignService.GetAllAsync();

            var campaignsByOperator = new Dictionary<int, List<int>>();
            foreach (var campaign in _campaigns)
            {
                var ops = await http.GetFromJsonAsync<List<Operator>>($"/api/v1/campaigns/{campaign.ID}/operators") ?? [];
                foreach (var op in ops)
                {
                    (campaignsByOperator.TryGetValue(op.ID, out var list) ? list : campaignsByOperator[op.ID] = []).Add(campaign.ID);
                }
            }

            var admins = await AdminService.GetAllAsync();
            var operators = await OperatorService.GetAllAsync();
            _rows =
            [
                .. admins.Select(a => new OperatorRow(a.ID, a.Username, a.Password, true, [], a.LastLogin)),
                .. operators.Select(o => new OperatorRow(o.ID, o.Username, o.Password, false,
                    campaignsByOperator.TryGetValue(o.ID, out var ids) ? ids : [], o.LastLogin)),
            ];

            _selected = _rows.FirstOrDefault(r => r.Id == _selected?.Id && r.IsAdmin == _selected?.IsAdmin) ?? _rows.FirstOrDefault(r => !r.IsAdmin);
            _error = null;
            Layout.SetCounts(campaigns: _campaigns.Count, operators: _rows.Count);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            _error = ServerDown.Is(ex) ? ServerDown.Message : $"Couldn't load the accounts: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string CampaignNames(OperatorRow row) => row.IsAdmin
        ? "all"
        : row.CampaignIds.Count == 0 ? "–" : string.Join(", ", _campaigns.Where(c => row.CampaignIds.Contains(c.ID)).Select(c => c.Name));

    private void Select(OperatorRow row)
    {
        _selected = row;
        _confirmRemove = false;
    }

    private async Task OpenAsync(OperatorDialogMode mode)
    {
        _confirmRemove = false;
        var parameters = new DialogParameters<CreateOperatorDialog>
        {
            { d => d.Mode, mode },
            { d => d.Existing, mode == OperatorDialogMode.Create ? null : _selected },
            { d => d.Campaigns, _campaigns },
        };

        var dialog = await DialogService.ShowAsync<CreateOperatorDialog>(string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task RemoveAsync()
    {
        if (_selected is null)
        {
            return;
        }

        if (!_confirmRemove)
        {
            _confirmRemove = true;
            return;
        }

        _confirmRemove = false;
        try
        {
            var removed = _selected.IsAdmin ? await AdminService.DeleteAsync(_selected.Id) : await OperatorService.DeleteAsync(_selected.Id);
            _error = removed ? null : $"The team server refused to remove {_selected.Username}.";
            _selected = null;
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ServerDown.Is(ex) ? ServerDown.Message : $"Couldn't reach the team server: {ex.Message}";
        }
    }
}
