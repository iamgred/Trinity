@page "/admin/operators"
@layout AdminLayout
@using System.Net.Http.Json
@using System.Text.Json
@using Client.Components.Layout
@using Client.Components.UI
@using Client.Services
@using Campaign = Trinity.Shared.Models.Campaign
@using Operator = Trinity.Shared.Models.Operator
@inject OperatorService OperatorService
@inject AdminService AdminService
@inject CampaignService CampaignService
@inject IHttpClientFactory HttpFactory

<PageTitle>Trinity · Operators</PageTitle>

<div class="ops-page">
    <div class="ops-head">
        <div>
            <MudText Typo="Typo.h5" Class="ops-head__title">Operators</MudText>
            <MudText Class="ops-head__sub">Admins create every account. There is no self-registration.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   Class="ops-btn ops-btn--primary" OnClick="() => Open(OperatorDialogMode.Create)">Create Operator</MudButton>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="ops__error">@_error</MudAlert>
    }

    <MudPaper Elevation="0" Class="ops__card">
        @if (_loading && _rows.Count == 0)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
        }
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Square="true" Class="ops__table">
            <colgroup><col style="width:5.6%" /><col style="width:15.5%" /><col style="width:15.2%" /><col style="width:42.7%" /><col style="width:21%" /></colgroup>
            <thead><tr><th>id</th><th>username</th><th>role</th><th>campaigns</th><th>last login</th></tr></thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr class="ops__empty"><td colspan="5">@(_loading ? "Loading accounts…" : "No accounts yet.")</td></tr>
                }
                @foreach (var row in _rows)
                {
                    <tr class="@(row == _selected ? "is-selected" : null)" @onclick="() => _selected = row">
                        <td>@row.Id</td>
                        <td>@row.Username</td>
                        <td>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(row.IsAdmin ? Color.Primary : Color.Info)"
                                     Icon="@Icons.Material.Filled.Circle" Class="ops__role">@(row.IsAdmin ? "ADMIN" : "OPERATOR")</MudChip>
                        </td>
                        <td>@CampaignNames(row)</td>
                        <td>@(row.LastLogin is { } login && login > DateTime.MinValue ? login.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "never")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <div class="ops__actions">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" Class="ops-btn"
                   Disabled="@(_selected is null)" OnClick="() => Open(OperatorDialogMode.Edit)">Edit</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Key" Class="ops-btn"
                   Disabled="@(_selected is null)" OnClick="() => Open(OperatorDialogMode.ResetPassword)">Reset Password</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" Class="ops-btn ops-btn--danger"
                   Disabled="@(_selected is null)" OnClick="RemoveAsync">@(_confirmRemove ? $"Remove {_selected?.Username}?" : "Remove")</MudButton>
    </div>
</div>

@if (_dialogMode is { } mode)
{
    <CreateOperatorDialog Mode="mode" Existing="@(mode == OperatorDialogMode.Create ? null : _selected)" Campaigns="_campaigns"
                          OnClose="() => _dialogMode = null" OnSaved="OnSavedAsync" />
}

@code {
    [CascadingParameter] private AdminLayout Layout { get; set; } = default!;

    private List<OperatorRow> _rows = [];
    private List<Campaign> _campaigns = [];
    private OperatorRow? _selected;
    private OperatorDialogMode? _dialogMode;
    private bool _confirmRemove;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("TeamServer");
            _campaigns = await CampaignService.GetTasksAsync();

            var campaignsByOperator = new Dictionary<int, List<int>>();
            foreach (var campaign in _campaigns)
            {
                var ops = await http.GetFromJsonAsync<List<Operator>>($"/api/v1/campaigns/{campaign.ID}/operators") ?? [];
                foreach (var op in ops)
                {
                    (campaignsByOperator.TryGetValue(op.ID, out var list) ? list : campaignsByOperator[op.ID] = []).Add(campaign.ID);
                }
            }

            var admins = await AdminService.GetTasksAsync();
            var operators = await OperatorService.GetTasksAsync();
            _rows =
            [
                .. admins.Select(a => new OperatorRow(a.ID, a.Username, a.Password, true, [], a.LastLogin)),
                .. operators.Select(o => new OperatorRow(o.ID, o.Username, o.Password, false,
                    campaignsByOperator.TryGetValue(o.ID, out var ids) ? ids : [], o.LastLogin)),
            ];

            _selected = _rows.FirstOrDefault(r => r.Id == _selected?.Id && r.IsAdmin == _selected?.IsAdmin) ?? _rows.FirstOrDefault(r => !r.IsAdmin);
            _error = null;
            Layout.SetCounts(campaigns: _campaigns.Count, operators: _rows.Count);
        }
        catch (Exception e) when (e is HttpRequestException or JsonException or TaskCanceledException)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not load accounts: {e.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string CampaignNames(OperatorRow row) => row.IsAdmin
        ? "all"
        : row.CampaignIds.Count == 0 ? "–" : string.Join(", ", _campaigns.Where(c => row.CampaignIds.Contains(c.ID)).Select(c => c.Name));

    private void Open(OperatorDialogMode mode)
    {
        _confirmRemove = false;
        _dialogMode = mode;
    }

    private async Task OnSavedAsync()
    {
        _dialogMode = null;
        await LoadAsync();
    }

    // click twice to confirm
    private async Task RemoveAsync()
    {
        if (_selected is null)
        {
            return;
        }

        if (!_confirmRemove)
        {
            _confirmRemove = true;
            return;
        }

        _confirmRemove = false;
        try
        {
            var removed = _selected.IsAdmin ? await AdminService.DeleteAsync(_selected.Id) : await OperatorService.DeleteAsync(_selected.Id);
            _error = removed ? null : $"The team server refused to remove {_selected.Username}.";
            _selected = null;
            await LoadAsync();
        }
        catch (HttpRequestException e)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
    }
}
