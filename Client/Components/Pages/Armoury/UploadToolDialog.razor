@using Client.Components.Shell
@using Client.Services
@using Client.Components.UI
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IHttpClientFactory HttpFactory
@inject OperatorService OperatorService
@inject ProtectedSessionStorage Session

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Outlined.FileUpload" Title="Upload Tool" Subtitle="Add a .NET assembly to the armoury" />
    </TitleContent>
    <DialogContent>
        <FormRow Label="File" Top="true">
            <MudFileUpload T="IBrowserFile" Files="_file" FilesChanged="OnFileChanged" Accept=".exe,.dll" MaxFileSize="MaxBytes">
                <CustomContent>
                    <div class="t-file-box" @onclick="context.OpenFilePickerAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Color="@(_file is null ? Color.Default : Color.Primary)" Style="font-size:18px;" />
                        <div style="flex:1;min-width:0;">
                            @if (_file is null)
                            {
                                <div style="font-size:13px;">Choose a file…</div>
                                <div class="t-form-hint" style="margin-top:2px;">.exe or .dll, up to @(MaxBytes / 1_048_576) MB</div>
                            }
                            else
                            {
                                <div class="mono" style="font-size:13px;overflow:hidden;text-overflow:ellipsis;">@_file.Name</div>
                                <div class="t-form-hint" style="margin-top:2px;">@FormatSize(_file.Size)</div>
                            }
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined">@(_file is null ? "Browse" : "Change")</MudButton>
                    </div>
                </CustomContent>
                <SelectedTemplate />
            </MudFileUpload>
        </FormRow>

        <FormRow Label="Name" Hint="What operators will see in the armoury" Top="true">
            <MudTextField @bind-Value="_name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </FormRow>

        <FormRow Label="Type">
            <span class="d-inline-flex gap-2">
                <span class="t-lock-chip"><MudIcon Icon="@Icons.Material.Outlined.Lock" />x64</span>
                <span class="t-lock-chip"><MudIcon Icon="@Icons.Material.Outlined.Lock" />.NET assembly</span>
            </span>
        </FormRow>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" role="alert">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <span class="t-dialog-note">Stored on the team server for every operator.</span>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="UploadAsync">@(_busy ? "Uploading…" : "Upload")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private const long MaxBytes = 50L * 1024 * 1024;

    private IBrowserFile? _file;
    private string _name = "";
    private string? _error;
    private bool _busy;

    private void OnFileChanged(IBrowserFile? file)
    {
        _file = file;
        _error = null;

        if (file is not null && string.IsNullOrWhiteSpace(_name))
        {
            _name = Path.GetFileNameWithoutExtension(file.Name);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task UploadAsync()
    {
        _error = null;
        if (_file is null || string.IsNullOrWhiteSpace(_name))
        {
            _error = "Pick a file and give it a name.";
            return;
        }

        _busy = true;
        try
        {
            var operatorId = await GetOperatorIdAsync();
            if (operatorId is null)
            {
                _error = "Your account isn't in the operator list, so the team server won't accept the upload.";
                return;
            }

            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(_name.Trim()), "Name");
            form.Add(new StringContent(operatorId.Value.ToString()), "OperatorID");
            var fileContent = new StreamContent(_file.OpenReadStream(MaxBytes));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            form.Add(fileContent, "file", _file.Name);

            var http = HttpFactory.CreateClient("TeamServer");
            var response = await http.PostAsync("/api/v1/armoury/upload", form);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = body.Contains("Tools.Conflict")
                    ? $"A tool called {_file.Name} is already in the armoury."
                    : $"The team server refused the upload ({(int)response.StatusCode}).";
                return;
            }

            MudDialog.Close(DialogResult.Ok(_name.Trim()));
        }
        catch (IOException e)
        {
            _error = $"Could not read the file: {e.Message}";
        }
        catch (HttpRequestException e)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<int?> GetOperatorIdAsync()
    {
        var stored = await Session.GetAsync<ShellUser>(ShellUser.StorageKey);
        if (!stored.Success || stored.Value is null)
        {
            return null;
        }

        var operators = await OperatorService.GetAllAsync();
        return operators.FirstOrDefault(o => o.Username.Equals(stored.Value.Name, StringComparison.OrdinalIgnoreCase))?.ID;
    }

    private static string FormatSize(long bytes) => bytes >= 1_048_576 ? $"{bytes / 1_048_576.0:0.0} MB" : $"{Math.Max(1, (int)Math.Round(bytes / 1024.0))} KB";
}
