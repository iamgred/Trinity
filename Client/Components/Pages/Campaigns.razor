@page "/campaigns"
@page "/admin/campaigns"
@layout AdminLayout
@using System.Net.Http.Json
@using System.Text.Json
@using Client.Components.Shell
@using Client.Components.UI
@using Client.Components.Pages.Dialogs
@using Client.Services
@using Campaign = Trinity.Shared.Models.Campaign
@using Operator = Trinity.Shared.Models.Operator
@inject CampaignService CampaignService
@inject OperatorService OperatorService
@inject IHttpClientFactory HttpFactory
@inject IDialogService DialogService

<PageTitle>Trinity · Campaigns</PageTitle>

<div class="camp-page">
    <div class="camp-head">
        <div>
            <MudText Typo="Typo.h5" Class="camp-head__title">Campaigns</MudText>
            <MudText Class="camp-head__sub">Agents, payloads and operator access are scoped to a campaign.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                   Class="camp-btn camp-btn--primary" OnClick="NewCampaignAsync">New Campaign</MudButton>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="camp__error">@_error</MudAlert>
    }

    @if (_loading && _campaigns.Count == 0)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
    }

    <div class="camp">
        <div class="camp__list">
            @if (_campaigns.Count == 0 && _error is null && !_loading)
            {
                <MudText Class="camp__empty">No campaigns yet.</MudText>
            }
            @foreach (var campaign in _campaigns)
            {
                <MudPaper Elevation="0" Class="@($"camp__card{(campaign.ID == _selected?.ID ? " is-selected" : "")}")"
                          @onclick="() => SelectAsync(campaign)">
                    <div class="camp__card-top">
                        <MudIcon Icon="@Icons.Material.Outlined.Flag" Class="camp__flag" />
                        <span class="camp__card-name">@campaign.Name</span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                 Icon="@Icons.Material.Filled.Circle" Class="camp__status">ACTIVE</MudChip>
                    </div>
                    <div class="camp__card-meta">
                        <MudIcon Icon="@Icons.Material.Outlined.Monitor" /> – agents ·
                        <MudIcon Icon="@Icons.Material.Outlined.Group" /> @OperatorCount(campaign) operators
                    </div>
                </MudPaper>
            }
        </div>

        @if (_selected is not null)
        {
            <div class="camp__detail">
                <div class="camp__detail-head">
                    <div class="camp__detail-titles">
                        <div class="camp__detail-name">
                            <MudText Typo="Typo.h6" Class="camp__detail-title">@_selected.Name</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                     Icon="@Icons.Material.Filled.Circle" Class="camp__status">ACTIVE</MudChip>
                        </div>
                        <MudText Class="camp__detail-sub">Campaign #@_selected.ID</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" Class="camp-btn"
                               OnClick="OpenRename">Rename</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="camp-btn camp-btn--danger" Disabled="true"
                               Title="Needs a campaign status in the API">Close Campaign</MudButton>
                </div>

                <div class="camp__panels">
                    <MudPaper Elevation="0" Class="camp__panel">
                        <MudText Typo="Typo.overline" Class="camp__panel-label">ASSIGNED OPERATORS</MudText>
                        @foreach (var op in AssignedOperators)
                        {
                            <div class="camp__op">
                                <MudAvatar Size="Size.Small" Class="camp__avatar">@op.Username[..1].ToUpperInvariant()</MudAvatar>
                                <div class="camp__op-text">
                                    <span class="camp__op-name">@op.Username</span>
                                    <span class="camp__op-role">operator</span>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" Class="camp__op-remove"
                                               Title="@($"Remove {op.Username} from this campaign")" OnClick="() => UnassignAsync(op)" />
                            </div>
                        }

                        @if (_assignOpen)
                        {
                            <div class="camp__assign-pick">
                                @foreach (var op in UnassignedOperators)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Outlined.Add"
                                             OnClick="() => AssignAsync(op)">@op.Username</MudChip>
                                }
                                @if (!UnassignedOperators.Any())
                                {
                                    <MudText Class="camp__na">Every operator is already assigned.</MudText>
                                }
                            </div>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Outlined.Add"
                                   Class="camp__assign" OnClick="() => _assignOpen = !_assignOpen">Assign operator…</MudButton>
                    </MudPaper>

                    <MudPaper Elevation="0" Class="camp__panel">
                        <MudText Typo="Typo.overline" Class="camp__panel-label">AGENTS IN CAMPAIGN</MudText>
                        <MudText Class="camp__na">Not available yet: the agents API does not say which campaign an agent belongs to.</MudText>

                        <MudText Typo="Typo.overline" Class="camp__panel-label camp__panel-label--sub">PAYLOADS BUILT FOR THIS CAMPAIGN</MudText>
                        <MudText Class="camp__na">Not available yet: the payloads API does not return the campaign.</MudText>
                    </MudPaper>
                </div>
            </div>
        }
    </div>
</div>

@if (_renameOpen && _selected is not null)
{
    <TrinityDialog Title="Rename Campaign" Subtitle="@($"Campaign #{_selected.ID}")" Icon="@Icons.Material.Outlined.Edit"
                   Error="@_renameError" OnClose="() => _renameOpen = false">
        <ChildContent>
            <div class="td-row">
                <label for="rename-name">Name</label>
                <MudTextField T="string" @bind-Value="_renameValue" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="rename-name" />
            </div>
        </ChildContent>
        <Footer>
            <MudButton Variant="Variant.Outlined" OnClick="() => _renameOpen = false">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RenameAsync">Rename</MudButton>
        </Footer>
    </TrinityDialog>
}
