@page "/campaigns"
@page "/admin/campaigns"
@layout AdminLayout
@using System.Net.Http.Json
@using System.Text.Json
@using Client.Components.Shell
@using Client.Components.UI
@using Client.Components.Pages.Dialogs
@using Client.Services
@using Campaign = Trinity.Shared.Models.Campaign
@using Operator = Trinity.Shared.Models.Operator
@inject CampaignService CampaignService
@inject OperatorService OperatorService
@inject IHttpClientFactory HttpFactory
@inject IDialogService DialogService

<PageTitle>Trinity · Campaigns</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5" Style="font-weight:700;">Campaigns</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Agents, payloads and operator access are scoped to a campaign.</MudText>
    </MudStack>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewCampaignAsync">New Campaign</MudButton>
</MudStack>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@_error</MudAlert>
}

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudStack Spacing="2">
            @if (_campaigns.Count == 0 && _error is null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@(_loading ? "Loading campaigns…" : "No campaigns yet.")</MudText>
            }
            @foreach (var campaign in _campaigns)
            {
                var selected = campaign.ID == _selected?.ID;
                <MudPaper Outlined="true" Class="pa-3" @onclick="() => SelectAsync(campaign)"
                          Style="@($"cursor:pointer;{(selected ? "border-color:var(--mud-palette-primary);background:rgba(232,119,34,0.08);" : "")}")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" Color="@(selected ? Color.Primary : Color.Default)" />
                        <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@campaign.Name</MudText>
                        <MudSpacer />
                        <StatusPill Text="active" Tone="green" />
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1 mud-text-secondary">
                        <MudIcon Icon="@Icons.Material.Filled.Monitor" Style="font-size:14px;" />
                        <MudText Typo="Typo.caption">– agents ·</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.Group" Style="font-size:14px;" />
                        <MudText Typo="Typo.caption">@OperatorCount(campaign) operators</MudText>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    </MudItem>

    @if (_selected is not null)
    {
        <MudItem xs="12" md="8">
            <MudPaper Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">@_selected.Name</MudText>
                            <StatusPill Text="active" Tone="green" />
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Campaign #@_selected.ID</MudText>
                    </MudStack>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenRename">Rename</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Disabled="true" title="Needs a campaign status in the API">Close Campaign</MudButton>
                </MudStack>

                <MudGrid Spacing="3">
                    <MudItem xs="12" lg="6">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary">ASSIGNED OPERATORS</MudText>
                        <MudList T="string" Dense="true" Padding="false">
                            @foreach (var op in AssignedOperators)
                            {
                                <MudListItem T="string">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudAvatar Size="Size.Small" Color="Color.Primary">@op.Username[..1].ToUpperInvariant()</MudAvatar>
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2" Style="font-weight:600;">@op.Username</MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">operator</MudText>
                                        </MudStack>
                                        <MudSpacer />
                                        <MudTooltip Text="@($"Remove {op.Username} from this campaign")">
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => UnassignAsync(op)" />
                                        </MudTooltip>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>

                        <MudMenu Label="Assign operator…" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-1">
                            @foreach (var op in UnassignedOperators)
                            {
                                <MudMenuItem OnClick="() => AssignAsync(op)">@op.Username</MudMenuItem>
                            }
                            @if (!UnassignedOperators.Any())
                            {
                                <MudMenuItem Disabled="true">Every operator is already assigned.</MudMenuItem>
                            }
                        </MudMenu>
                    </MudItem>

                    <MudItem xs="12" lg="6">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary">AGENTS IN CAMPAIGN</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">Not available yet: the agents API does not say which campaign an agent belongs to.</MudAlert>

                        <MudText Typo="Typo.overline" Class="mud-text-secondary">PAYLOADS BUILT FOR THIS CAMPAIGN</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">Not available yet: the payloads API does not return the campaign.</MudAlert>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudDialog @bind-Visible="_renameOpen" Options="_dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Rename Campaign</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Campaign #@_selected?.ID</MudText>
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_renameValue" Label="Name" Variant="Variant.Outlined" Immediate="true" AutoFocus="true" />
            @if (_renameError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_renameError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _renameOpen = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="RenameAsync">Rename</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private AdminLayout Layout { get; set; } = default!;

    private List<Campaign> _campaigns = [];
    private List<Operator> _operators = [];
    private readonly Dictionary<int, List<Operator>> _assigned = [];
    private Campaign? _selected;
    private string? _error;
    private bool _loading;

    private bool _renameOpen;
    private string _renameValue = "";
    private string? _renameError;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private HttpClient Http => HttpFactory.CreateClient("TeamServer");

    private IEnumerable<Operator> AssignedOperators => _selected is not null && _assigned.TryGetValue(_selected.ID, out var ops) ? ops : [];

    private IEnumerable<Operator> UnassignedOperators => _operators.Where(o => AssignedOperators.All(a => a.ID != o.ID));

    private int OperatorCount(Campaign campaign) => _assigned.TryGetValue(campaign.ID, out var ops) ? ops.Count : 0;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _campaigns = await CampaignService.GetAllAsync();
            _operators = await OperatorService.GetAllAsync();
            _assigned.Clear();
            foreach (var campaign in _campaigns)
            {
                _assigned[campaign.ID] = await LoadAssignedAsync(campaign.ID);
            }

            _selected = _campaigns.FirstOrDefault(c => c.ID == _selected?.ID) ?? _campaigns.FirstOrDefault();
            _error = null;
            Layout.SetCounts(campaigns: _campaigns.Count, operators: _operators.Count);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            _error = ServerDown.Is(ex) ? ServerDown.Message : $"Couldn't load the campaigns: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<List<Operator>> LoadAssignedAsync(int campaignId) =>
        await Http.GetFromJsonAsync<List<Operator>>($"/api/v1/campaigns/{campaignId}/operators") ?? [];

    private Task SelectAsync(Campaign campaign)
    {
        _selected = campaign;
        return Task.CompletedTask;
    }

    private async Task NewCampaignAsync()
    {
        var dialog = await DialogService.ShowAsync<CreateNewCampaignDialog>(string.Empty, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task AssignAsync(Operator op) => await ChangeAssignmentAsync(op, assign: true);

    private async Task UnassignAsync(Operator op) => await ChangeAssignmentAsync(op, assign: false);

    private async Task ChangeAssignmentAsync(Operator op, bool assign)
    {
        if (_selected is null)
        {
            return;
        }

        var url = $"/api/v1/campaigns/{_selected.ID}/operators/{op.ID}";
        try
        {
            var response = assign ? await Http.PostAsync(url, null) : await Http.DeleteAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"The team server refused the change ({(int)response.StatusCode}).";
                return;
            }

            _assigned[_selected.ID] = await LoadAssignedAsync(_selected.ID);
            _error = null;
        }
        catch (HttpRequestException e)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
    }

    private void OpenRename()
    {
        _renameValue = _selected?.Name ?? "";
        _renameError = null;
        _renameOpen = true;
    }

    private async Task RenameAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_renameValue))
        {
            _renameError = "Enter a name.";
            return;
        }

        try
        {
            var response = await Http.PutAsJsonAsync($"/api/v1/campaigns/{_selected.ID}", new Campaign { ID = _selected.ID, Name = _renameValue.Trim() });
            if (!response.IsSuccessStatusCode)
            {
                _renameError = $"The team server refused the rename ({(int)response.StatusCode}).";
                return;
            }

            _renameOpen = false;
            await LoadAsync();
        }
        catch (HttpRequestException e)
        {
            _renameError = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
    }
}
