@page "/campaigns"
@page "/admin/campaigns"
@layout AdminLayout
@using System.Net.Http.Json
@using System.Text.Json
@using Client.Components.Shell
@using Client.Components.UI
@using Client.Components.Pages.Dialogs
@using Client.Services
@using Campaign = Trinity.Shared.Models.Campaign
@using Operator = Trinity.Shared.Models.Operator
@inject CampaignService CampaignService
@inject OperatorService OperatorService
@inject IHttpClientFactory HttpFactory
@inject IDialogService DialogService

<PageTitle>Trinity · Campaigns</PageTitle>

<div class="ts-admin-head">
    <div>
        <h3>Campaigns</h3>
        <p>Agents, payloads and operator access are scoped to a campaign.</p>
    </div>
    <button type="button" class="ts-btn ts-btn--primary" @onclick="NewCampaignAsync"><Icon Name="btn-plus.svg" Size="13" /> New Campaign</button>
</div>

@if (_error is not null)
{
    <p class="camp__error" role="alert">@_error</p>
}

<div class="camp">
    <div class="camp__list">
        @if (_campaigns.Count == 0 && _error is null)
        {
            <p class="camp__empty">@(_loading ? "Loading campaigns…" : "No campaigns yet.")</p>
        }
        @foreach (var campaign in _campaigns)
        {
            <button type="button" class="camp__card @(campaign.ID == _selected?.ID ? "is-selected" : null)" @onclick="() => SelectAsync(campaign)">
                <span class="camp__card-top">
                    <Icon Name="lucide-flag.svg" Size="14" />
                    <span class="camp__card-name">@campaign.Name</span>
                    @* TODO(connect to backend): campaigns have no status yet *@
                    <StatusPill Text="active" Tone="green" />
                </span>
                <span class="camp__card-meta">
                    @* TODO(connect to backend): agents aren't linked to campaigns yet *@
                    <Icon Name="lucide-monitor.svg" Size="11" /> – agents ·
                    <Icon Name="lucide-users.svg" Size="11" /> @OperatorCount(campaign) operators
                </span>
            </button>
        }
    </div>

    @if (_selected is not null)
    {
        <div class="camp__detail">
            <div class="camp__detail-head">
                <div>
                    <h4>@_selected.Name <StatusPill Text="active" Tone="green" /></h4>
                    @* TODO(connect to backend): no created date or creator yet *@
                    <p>Campaign #@_selected.ID</p>
                </div>
                <button type="button" class="ts-btn" @onclick="OpenRename"><Icon Name="lucide-pencil.svg" Size="13" /> Rename</button>
                <button type="button" class="ts-btn ts-btn--danger" disabled title="Needs a campaign status in the API">Close Campaign</button>
            </div>

            <div class="camp__panels">
                <section class="camp__panel">
                    <h5>ASSIGNED OPERATORS</h5>
                    @foreach (var op in AssignedOperators)
                    {
                        <div class="camp__op">
                            <span class="camp__avatar">@op.Username[..1].ToUpperInvariant()</span>
                            <span class="camp__op-text"><b>@op.Username</b><small>operator</small></span>
                            <button type="button" title="Remove @op.Username from this campaign" @onclick="() => UnassignAsync(op)"><Icon Name="lucide-x.svg" Size="13" /></button>
                        </div>
                    }

                    @if (_assignOpen)
                    {
                        <div class="camp__assign-pick">
                            @foreach (var op in UnassignedOperators)
                            {
                                <button type="button" @onclick="() => AssignAsync(op)">@op.Username</button>
                            }
                            @if (!UnassignedOperators.Any())
                            {
                                <span>Every operator is already assigned.</span>
                            }
                        </div>
                    }
                    <button type="button" class="camp__assign" @onclick="() => _assignOpen = !_assignOpen">
                        <Icon Name="btn-plus.svg" Size="13" /> Assign operator…
                    </button>
                </section>

                <section class="camp__panel">
                    <h5>AGENTS IN CAMPAIGN</h5>
                    @* TODO(connect to backend): agents and payloads don't say which campaign they're in *@
                    <p class="camp__na">Not available yet: the agents API does not say which campaign an agent belongs to.</p>

                    <h5 class="camp__panel-sub">PAYLOADS BUILT FOR THIS CAMPAIGN</h5>
                    <p class="camp__na">Not available yet: the payloads API does not return the campaign.</p>
                </section>
            </div>
        </div>
    }
</div>

@if (_renameOpen && _selected is not null)
{
    <Modal Title="Rename Campaign" Subtitle="@($"Campaign #{_selected.ID}")" IconName="lucide-pencil.svg" Error="@_renameError"
           OnClose="() => _renameOpen = false">
        <ChildContent>
            <div class="ts-modal__row">
                <label for="rename-name">Name</label>
                <div class="ts-field"><input id="rename-name" @bind="_renameValue" @bind:event="oninput" /></div>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="ts-btn" @onclick="() => _renameOpen = false">Cancel</button>
            <button type="button" class="ts-btn ts-btn--primary" @onclick="RenameAsync">Rename</button>
        </Footer>
    </Modal>
}

@code {
    [CascadingParameter] private AdminLayout Layout { get; set; } = default!;

    private List<Campaign> _campaigns = [];
    private List<Operator> _operators = [];
    private readonly Dictionary<int, List<Operator>> _assigned = [];
    private Campaign? _selected;
    private string? _error;
    private bool _loading;
    private bool _assignOpen;

    private bool _renameOpen;
    private string _renameValue = "";
    private string? _renameError;

    private HttpClient Http => HttpFactory.CreateClient("TeamServer");

    private IEnumerable<Operator> AssignedOperators => _selected is not null && _assigned.TryGetValue(_selected.ID, out var ops) ? ops : [];

    private IEnumerable<Operator> UnassignedOperators => _operators.Where(o => AssignedOperators.All(a => a.ID != o.ID));

    private int OperatorCount(Campaign campaign) => _assigned.TryGetValue(campaign.ID, out var ops) ? ops.Count : 0;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _campaigns = await CampaignService.GetAllAsync();
            _operators = await OperatorService.GetAllAsync();
            _assigned.Clear();
            foreach (var campaign in _campaigns)
            {
                _assigned[campaign.ID] = await LoadAssignedAsync(campaign.ID);
            }

            _selected = _campaigns.FirstOrDefault(c => c.ID == _selected?.ID) ?? _campaigns.FirstOrDefault();
            _error = null;
            Layout.SetCounts(campaigns: _campaigns.Count, operators: _operators.Count);
        }
        catch (Exception e) when (e is HttpRequestException or JsonException or TaskCanceledException)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not load campaigns: {e.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<List<Operator>> LoadAssignedAsync(int campaignId) =>
        await Http.GetFromJsonAsync<List<Operator>>($"/api/v1/campaigns/{campaignId}/operators") ?? [];

    private Task SelectAsync(Campaign campaign)
    {
        _selected = campaign;
        _assignOpen = false;
        return Task.CompletedTask;
    }

    // opens the teammate's New Campaign popup (screen 10)
    private async Task NewCampaignAsync()
    {
        var dialog = await DialogService.ShowAsync<CreateNewCampaignDialog>(string.Empty, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task AssignAsync(Operator op) => await ChangeAssignmentAsync(op, assign: true);

    private async Task UnassignAsync(Operator op) => await ChangeAssignmentAsync(op, assign: false);

    private async Task ChangeAssignmentAsync(Operator op, bool assign)
    {
        if (_selected is null)
        {
            return;
        }

        var url = $"/api/v1/campaigns/{_selected.ID}/operators/{op.ID}";
        try
        {
            var response = assign ? await Http.PostAsync(url, null) : await Http.DeleteAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"The team server refused the change ({(int)response.StatusCode}).";
                return;
            }

            _assigned[_selected.ID] = await LoadAssignedAsync(_selected.ID);
            _assignOpen = false;
            _error = null;
        }
        catch (HttpRequestException e)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
    }

    private void OpenRename()
    {
        _renameValue = _selected?.Name ?? "";
        _renameError = null;
        _renameOpen = true;
    }

    private async Task RenameAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_renameValue))
        {
            _renameError = "Enter a name.";
            return;
        }

        try
        {
            var response = await Http.PutAsJsonAsync($"/api/v1/campaigns/{_selected.ID}", new Campaign { ID = _selected.ID, Name = _renameValue.Trim() });
            if (!response.IsSuccessStatusCode)
            {
                _renameError = $"The team server refused the rename ({(int)response.StatusCode}).";
                return;
            }

            _renameOpen = false;
            await LoadAsync();
        }
        catch (HttpRequestException e)
        {
            _renameError = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
    }
}
