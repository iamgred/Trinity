@namespace Client.Components.Pages.Dialogs
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <TitleContent>
        <div style="display:flex; align-items:center; gap:10px;">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Style="color:#E87722;" />
            <MudText Typo="Typo.h6" Style="color:white; font-weight:600;">Add Tool</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudDivider Style="background-color:#E87722; height:2px; margin-bottom:20px;" />
        <div style="display:flex; flex-direction:column; gap:16px;">
            <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined"
                          Placeholder="e.g. whoami.o" FullWidth="true" />

            <div class="atd-file-zone" @onclick="TriggerPicker">
                @if (_file is null)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
                         fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                    <span class="atd-file-hint">Click to choose a file</span>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" stroke="#35C759" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span class="atd-file-name">@_file.Name</span>
                    <span class="atd-file-size">@FormatSize(_file.Size)</span>
                }
                <InputFile id="atd-file-input" OnChange="OnFileChange" style="display:none" />
            </div>

            @if (_error is not null)
            {
                <span style="color:#f44336; font-size:0.80rem;">@_error</span>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div style="display:flex; justify-content:flex-end; gap:8px; width:100%; padding:4px 0 0 0;">
            <MudButton Variant="Variant.Text"
                       Style="color:rgba(255,255,255,0.5); text-transform:none;"
                       OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled"
                       Style="background:#E87722; color:white; text-transform:none; border-radius:24px; min-width:110px;"
                       OnClick="Confirm"
                       Disabled="@(!CanConfirm)">
                Add Tool
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    .atd-file-zone {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 24px 16px;
        border: 1.5px dashed rgba(255,255,255,0.15);
        border-radius: 8px;
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
        min-height: 90px;
    }
    .atd-file-zone:hover { border-color: rgba(232,119,34,0.5); background: rgba(232,119,34,0.04); }
    .atd-file-hint { font-size: 0.80rem; color: rgba(255,255,255,0.30); }
    .atd-file-name { font-size: 0.84rem; color: rgba(255,255,255,0.80); font-weight: 500; word-break: break-all; text-align: center; }
    .atd-file-size { font-size: 0.72rem; color: rgba(255,255,255,0.35); }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    private string _name = string.Empty;
    private IBrowserFile? _file;
    private string? _error;

    private bool CanConfirm => !string.IsNullOrWhiteSpace(_name) && _file is not null;

    private async Task TriggerPicker()
        => await JS.InvokeVoidAsync("document.getElementById('atd-file-input').click");

    private void OnFileChange(InputFileChangeEventArgs e)
    {
        _file = e.File;
        if (string.IsNullOrWhiteSpace(_name))
            _name = Path.GetFileNameWithoutExtension(e.File.Name);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        if (!CanConfirm) { _error = "Provide a name and file."; return; }
        MudDialog.Close(DialogResult.Ok((_name.Trim(), _file!)));
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }
}
