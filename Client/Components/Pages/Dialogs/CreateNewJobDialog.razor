@namespace Client.Components.Pages.Dialogs
@rendermode InteractiveServer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Style="color:white; font-weight:700;">Create New Job</MudText>
    </TitleContent>
    <DialogContent>
        <MudDivider Style="background-color:#E87722; height:2px; margin-bottom:20px;" />
        <MudTextField @bind-Value="_jobName" Label="Job Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" FullWidth="true" Class="mb-4" />
        <MudTextField @bind-Value="_desc" Label="Job Description" Variant="Variant.Outlined"
                      Margin="Margin.Dense" FullWidth="true" Lines="5" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Style="min-width:100px;">Confirm</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] private IMudDialogInstance MudDialog {get; set; } = default!;

    private string _jobName = string.Empty;
    private string _company = string.Empty;
    private string _desc = string.Empty;

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
}
