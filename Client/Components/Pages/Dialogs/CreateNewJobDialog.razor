@namespace Client.Components.Pages.Dialogs
@rendermode InteractiveServer
@using Client.Services
@inject TaskApiService TaskService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Style="color:white; font-weight:700;">Create New Job</MudText>
    </TitleContent>
    <DialogContent>
        <MudDivider Style="background-color:#E87722; height:2px; margin-bottom:20px;" />
        <MudTextField @bind-Value="_jobName" Label="Job Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" FullWidth="true" Class="mb-4" />
        <MudTextField @bind-Value="_desc" Label="Job Description" Variant="Variant.Outlined"
                      Margin="Margin.Dense" FullWidth="true" Lines="5" Class="mb-2" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudText Style="color:#f44336; font-size:0.85rem; margin-top:8px;">@_error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Style="min-width:100px;" Disabled="@_loading">
            @(_loading ? "Creating..." : "Confirm")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _jobName = string.Empty;
    private string _desc    = string.Empty;
    private string _error   = string.Empty;
    private bool   _loading = false;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_jobName))
        {
            _error = "Job name is required.";
            return;
        }
        _loading = true;
        _error   = string.Empty;

        var result = await TaskService.CreateCampaignAsync(_jobName);
        _loading = false;

        if (result is not null)
            MudDialog.Close(DialogResult.Ok(true));
        else
            _error = "Failed to create job. Check TeamServer is running.";
    }
}