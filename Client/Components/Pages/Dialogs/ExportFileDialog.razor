@namespace Client.Components.Pages.Dialogs
@rendermode InteractiveServer
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Style="color:white; font-weight:700;">Export File</MudText>
    </TitleContent>
    <DialogContent>
        <MudDivider Style="background-color:#E87722; height:2px; margin-bottom:20px;" />
        <div style="background-color:#1A1A1A; border:2px dashed #444; border-radius:6px;
                    padding:48px 24px; text-align:center; cursor:pointer;" @onclick="TriggerBrowse">
            <MudIcon Icon="@Icons.Material.Outlined.FileUpload"
                     Style="color:#E87722; font-size:4rem; display:block; margin:0 auto 12px;" />
            <p style="color:#AAAAAA; font-size:0.875rem; margin:0;">Select a file to export</p>
        </div>
        <div style="text-align:center; margin-top:14px;">
            <InputFile id="export-file-input" OnChange="OnFileSelected" style="display:none;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FolderOpen"
                       Style="text-transform:none; min-width:110px;"
                       OnClick="TriggerBrowse">Browse</MudButton>
        </div>
        @if (!string.IsNullOrEmpty(_fileName))
        {
            <div style="margin-top:12px; display:flex; align-items:center; gap:8px;">
                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Style="color:#E87722;" />
                <span style="color:#ccc; font-size:0.85rem;">@_fileName</span>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Style="min-width:100px;" Disabled="@string.IsNullOrEmpty(_fileName)">Confirm</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private string _fileName = string.Empty;
    private async Task TriggerBrowse()
        => await JS.InvokeVoidAsync("eval", "document.getElementById('export-file-input').click()");
    private void OnFileSelected(InputFileChangeEventArgs e) => _fileName = e.File.Name;
    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
}