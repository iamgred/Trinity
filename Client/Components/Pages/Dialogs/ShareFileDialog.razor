@namespace Client.Components.Pages.Dialogs
@rendermode InteractiveServer
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Style="color:white; font-weight:700;">Share File</MudText>
    </TitleContent>
    <DialogContent>
        <MudDivider Style="background-color:#E87722; height:2px; margin-bottom:20px;" />
        <div style="background-color:#1A1A1A; border:2px dashed #444; border-radius:6px;
                    padding:48px 24px; text-align:center; cursor:pointer;" @onclick="TriggerBrowse">
            <MudIcon Icon="@Icons.Material.Outlined.Share"
                     Style="color:#E87722; font-size:4rem; display:block; margin:0 auto;" />
        </div>
        <div style="text-align:center; margin:14px 0;">
            <InputFile id="share-file-input" OnChange="OnFileSelected" style="display:none;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FolderOpen"
                       Style="text-transform:none; min-width:110px;"
                       OnClick="TriggerBrowse">Browse</MudButton>
        </div>
        @if (!string.IsNullOrEmpty(_fileName))
        {
            <div style="margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Style="color:#E87722;" />
                <span style="color:#ccc; font-size:0.85rem;">@_fileName</span>
            </div>
        }
        <MudSelect @bind-Value="_deliveryMethod" T="string" Label="Delivery Method"
                   Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
            <MudSelectItem Value="@("none")">Select Type</MudSelectItem>
            <MudSelectItem Value="@("link")">Shareable Link</MudSelectItem>
            <MudSelectItem Value="@("email")">Email</MudSelectItem>
            <MudSelectItem Value="@("direct")">Direct Transfer</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Style="min-width:100px;"
                   Disabled="@(string.IsNullOrEmpty(_fileName) || _deliveryMethod == "none")">Confirm</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private string _fileName       = string.Empty;
    private string _deliveryMethod = "none";
    private async Task TriggerBrowse()
        => await JS.InvokeVoidAsync("eval", "document.getElementById('share-file-input').click()");
    private void OnFileSelected(InputFileChangeEventArgs e) => _fileName = e.File.Name;
    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
}