@page "/"
@page "/login"
@layout AuthLayout
@namespace Client.Components.Pages.Login
@inject NavigationManager Nav

<PageTitle>Trinity · Sign In</PageTitle>

<div class="t-login">
    <img src="img/shell/login-bg-logo.svg" alt="" width="980" height="980"
         style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);opacity:0.07;pointer-events:none;max-width:none;" />

    <div class="t-login-card">
        <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
            <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="mb-6">
                <img src="img/shell/login-logo.svg" alt="Trinity logo" width="120" height="120" />
                <span class="t-login-title mt-2">TRINITY</span>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Sign in to the team server</MudText>
            </MudStack>

            <label class="t-login-label">Username</label>
            <MudTextField @bind-Value="_username" Variant="Variant.Outlined" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                          autocomplete="username" aria-label="Username" Class="mb-4" />

            <label class="t-login-label">Password</label>
            <div style="position:relative;">
                <MudTextField @bind-Value="_password" Variant="Variant.Outlined" Immediate="true"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Key"
                              autocomplete="current-password" aria-label="Password" />
                <MudIconButton Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                               aria-label="@(_showPassword ? "Hide password" : "Show password")" Size="Size.Small"
                               Style="position:absolute;right:8px;top:50%;transform:translateY(-50%);color:var(--t-faint);"
                               OnClick="() => _showPassword = !_showPassword" />
            </div>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4" role="alert">@_error</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Class="t-login-btn mt-6" Disabled="_isSigningIn">
                @if (_isSigningIn)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    <span>Signing in…</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </MudButton>

            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="1" Class="mt-4">
                <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="mud-text-secondary" Style="font-size:13px;" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Accounts are created by an admin</MudText>
            </MudStack>
        </form>
    </div>

    <span class="t-login-footer">TRINITY · C2 FRAMEWORK</span>
</div>
