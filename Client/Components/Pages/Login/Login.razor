@page "/"
@page "/login"
@layout AuthLayout
@namespace Client.Components.Pages.Login

<PageTitle>Trinity · Sign In</PageTitle>

<div class="login-page">
    <div class="login-card">

        <img class="login-logo" src="img/trinity_logo.png" alt="Trinity logo" />
        <div class="login-wordmark">TRINITY</div>

        <div class="login-form">

            <label class="t-label-caps" for="server">Team Server</label>
            <div class="t-field">
                <span class="t-field-icon">
                    <svg viewBox="0 0 24 24"><path d="M4,1h16c1.1,0 2,0.9 2,2v4c0,1.1 -0.9,2 -2,2L4,9c-1.1,0 -2,-0.9 -2,-2L2,3c0,-1.1 0.9,-2 2,-2zM6,4v2h2L8,4L6,4zM4,15h16c1.1,0 2,0.9 2,2v4c0,1.1 -0.9,2 -2,2L4,23c-1.1,0 -2,-0.9 -2,-2v-4c0,-1.1 0.9,-2 2,-2zM6,18v2h2v-2L6,18z" /></svg>
                </span>
                <input id="server" type="url" placeholder="https://server:50050" @bind="_teamServerUrl" />
            </div>
            @if (_connectionError is not null)
            {
                <p class="login-error" role="alert">@_connectionError</p>
            }

            <label class="t-label-caps" for="email">Operator</label>
            <div class="t-field">
                <span class="t-field-icon">
                    <svg viewBox="0 0 24 24"><path d="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z" /></svg>
                </span>
                <input id="email" type="text" placeholder="Operator" @bind="_username" @bind:event="oninput" />
            </div>

            <label class="t-label-caps" for="password">Password</label>
            <div class="t-field">
                <span class="t-field-icon">
                    <svg viewBox="0 0 24 24"><path d="M12.65,10C11.83,7.67 9.61,6 7,6c-3.31,0 -6,2.69 -6,6s2.69,6 6,6c2.61,0 4.83,-1.67 5.65,-4L17,14v4h4v-4h2v-4L12.65,10zM7,14c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2z" /></svg>
                </span>
                <input id="password" type="@(_showPassword ? "text" : "password")" placeholder="Password" @bind="_password" @bind:event="oninput" />
                <button type="button" class="t-field-trailing" title="Show / hide password"
                        @onclick="() => _showPassword = !_showPassword">
                    <svg viewBox="0 0 24 24"><path d="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z" /></svg>
                </button>
            </div>

            <button type="button" class="t-btn t-btn-primary login-primary" @onclick="HandleLogin" disabled="@_isSigningIn">@(_isSigningIn ? "Signing in…" : "Connect & Sign In")</button>

            <button type="button" class="t-btn t-btn-secondary login-sso">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#EA4335" d="M12 10.2v3.9h5.5c-.24 1.4-1.7 4.1-5.5 4.1-3.3 0-6-2.7-6-6s2.7-6 6-6c1.9 0 3.1.8 3.9 1.5l2.6-2.6C17.1 3 14.8 2 12 2 6.5 2 2 6.5 2 12s4.5 10 10 10c5.8 0 9.6-4.1 9.6-9.8 0-.7-.1-1.2-.2-1.8H12z" /></svg>
                Sign in with Google
            </button>

            <a class="t-link login-register" href="#">Register with email and password</a>
        </div>

        <div class="login-footer">TRINITY · C2 FRAMEWORK</div>
    </div>
</div>
