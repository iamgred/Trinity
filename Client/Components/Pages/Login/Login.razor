@page "/login"
@layout AuthLayout
@namespace Client.Components.Pages.Login
@using Client.Components.UI
@inject NavigationManager Nav

<HeadContent>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
</HeadContent>

<PageTitle>Trinity · Sign In</PageTitle>

<div class="login">
    <img class="login__bg-logo" src="img/shell/login-bg-logo.svg" alt="" width="980" height="980" />

    <MudPaper Elevation="0" Class="login__card">
        <form class="login__form" @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
            <img class="login__logo" src="img/shell/login-logo.svg" alt="Trinity logo" width="150" height="150" />
            <MudText Class="login__word">TRINITY</MudText>
            <MudText Class="login__sub">Sign in to the team server</MudText>

            <label class="login__label" for="login-username">USERNAME</label>
            <div class="login__field">
                <MudTextField T="string" @bind-Value="_username" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputId="login-username" UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "username" })"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.PersonOutline" />
            </div>

            <label class="login__label" for="login-password">PASSWORD</label>
            <div class="login__field login__field--secret">
                <MudTextField T="string" @bind-Value="_password" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputId="login-password" InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "current-password" })"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Key" />
                <MudIconButton Class="login__eye" Size="Size.Small" Title="@(_showPassword ? "Hide password" : "Show password")"
                               Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                               OnClick="() => _showPassword = !_showPassword" />
            </div>

            @if (_error is not null)
            {
                <MudText Class="login__error" role="alert">@_error</MudText>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="_isSigningIn" Class="login__submit">@(_isSigningIn ? "Signing in…" : "Sign In")</MudButton>

            <div class="login__note"><MudIcon Icon="@Icons.Material.Outlined.Lock" Style="font-size:12px" /> Accounts are created by an admin</div>
        </form>
    </MudPaper>

    <div class="login__footer">TRINITY · C2 FRAMEWORK</div>
</div>
