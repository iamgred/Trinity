@page "/"
@page "/login"
@layout AuthLayout
@namespace Client.Components.Pages.Login
@using Client.Components.UI
@inject NavigationManager Nav

<HeadContent>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
</HeadContent>

<PageTitle>Trinity · Sign In</PageTitle>

<div class="login">
    <img class="login__bg-logo" src="img/shell/login-bg-logo.svg" alt="" width="980" height="980" />

    <form class="login__card" @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
        <img class="login__logo" src="img/shell/login-logo.svg" alt="Trinity logo" width="150" height="150" />
        <div class="login__word">TRINITY</div>
        <div class="login__sub">Sign in to the team server</div>

        <label class="login__label" for="login-username">USERNAME</label>
        <div class="login__field">
            <Icon Name="icon-user.svg" Size="16" />
            <input id="login-username" type="text" autocomplete="username" @bind="_username" @bind:event="oninput" />
        </div>

        <label class="login__label" for="login-password">PASSWORD</label>
        <div class="login__field">
            <Icon Name="icon-key.svg" Size="16" />
            <input id="login-password" class="@(_showPassword ? null : "is-secret")" type="@(_showPassword ? "text" : "password")"
                   autocomplete="current-password" @bind="_password" @bind:event="oninput" />
            <button type="button" class="login__eye" title="@(_showPassword ? "Hide password" : "Show password")"
                    @onclick="() => _showPassword = !_showPassword">
                <Icon Name="@(_showPassword ? "lucide-eye-off.svg" : "lucide-eye.svg")" Size="16" />
            </button>
        </div>

        @if (_error is not null)
        {
            <p class="login__error" role="alert">@_error</p>
        }

        <button type="submit" class="login__submit" disabled="@_isSigningIn">@(_isSigningIn ? "Signing in…" : "Sign In")</button>

        <div class="login__note"><Icon Name="icon-lock.svg" Size="12" /> Accounts are created by an admin</div>
    </form>

    <div class="login__footer">TRINITY · C2 FRAMEWORK</div>
</div>
