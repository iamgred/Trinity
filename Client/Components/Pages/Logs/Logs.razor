@page "/logs"
@layout WorkspaceLayout
@namespace Client.Components.Pages.Logs
@using Client.Components.Shell
@using Client.Components.UI

<PageTitle>Trinity · Event Log</PageTitle>

@if (State.EventsError is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Square="true" role="status">@State.EventsError</MudAlert>
}

<div role="log" aria-live="polite" style="flex:1;min-height:0;overflow:auto;">
    @if (State.Events.Count == 0 && State.EventsError is null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">@EmptyText</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Square="true" Style="font-family:'JetBrains Mono',monospace;">
            <tbody>
                @foreach (var entry in State.Events)
                {
                    <tr>
                        <td class="mud-text-secondary" style="width:90px;">@LocalTime(entry.Timestamp)</td>
                        <td style="width:110px;"><StatusPill Text="@entry.Type.ToString()" Tone="@ToneFor(entry.Type)" /></td>
                        <td>@entry.message</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</div>
