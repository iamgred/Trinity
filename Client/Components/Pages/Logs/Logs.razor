@page "/logs"
@namespace Client.Components.Pages.Logs
@rendermode InteractiveServer
@using Client.Components.Shell

<div class="logs-root">
    <div class="logs-header">
        <span class="logs-title">Event Log</span>
    </div>

    @if (_isLoading)
    {
        <div class="logs-state">Loading events…</div>
    }
    else if (_loadError is not null)
    {
        <div class="logs-state logs-error">@_loadError</div>
    }
    else if (_events.Count == 0)
    {
        <div class="logs-state logs-empty">No events recorded.</div>
    }
    else
    {
        <div class="logs-list">
            @foreach (var entry in _events)
            {
                <div class="log-entry log-tone-@entry.Tone">
                    <span class="log-time">@entry.Time.ToString("HH:mm:ss")</span>
                    <span class="log-sep">&nbsp;·&nbsp;</span>
                    @foreach (var part in entry.Parts)
                    {
                        <span class="@(string.IsNullOrEmpty(part.Style) ? "log-text" : $"log-text log-{part.Style}")">@part.Text</span>
                    }
                </div>
            }
        </div>
    }
</div>