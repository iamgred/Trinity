@page "/logs"
@layout WorkspaceLayout
@namespace Client.Components.Pages.Logs
@using Client.Components.Shell
@using Client.Components.UI

<PageTitle>Trinity · Event Log</PageTitle>

@if (_loadError is not null)
{
    <div class="ts-notice" role="status">
        <span>@_loadError</span>
        <button type="button" @onclick="LoadAsync">Retry</button>
    </div>
}

<div class="events" role="log" aria-live="polite">
    @if (_events.Count == 0 && _loadError is null)
    {
        <p class="events__empty">@(_isLoading ? "Loading events…" : "No events yet.")</p>
    }

    @foreach (var entry in _events)
    {
        <div class="events__row">
            <span class="events__time">@entry.Time.ToString("HH:mm:ss")</span>
            <span class="events__cat"><StatusPill Text="@entry.Category" Tone="@entry.Tone" /></span>
            <span class="events__msg">
                @foreach (var part in entry.Parts)
                {
                    <span class="@part.Style">@part.Text</span>
                }
            </span>
        </div>
    }
</div>
