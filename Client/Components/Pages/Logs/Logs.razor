@page "/logs"
@namespace Client.Components.Pages.Logs
@rendermode InteractiveServer
@using Client.Components.Shell
@using Client.Components.UI

<PageTitle>Trinity · Event Log</PageTitle>

<div class="events">
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Square="true" Class="events__notice">@_loadError</MudAlert>
    }

    @if (_isLoading && _events.Count == 0)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
    }

    <div class="events__scroll">
        @if (_events.Count == 0 && !_isLoading && _loadError is null)
        {
            <MudText Class="events__empty">No events recorded.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0" Square="true" Class="events__table">
                <colgroup>
                    <col style="width:86px" /><col style="width:114px" /><col />
                </colgroup>
                <tbody>
                    @foreach (var entry in _events)
                    {
                        <tr>
                            <td class="events__time">@entry.Time.ToString("HH:mm:ss")</td>
                            <td>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@TrinityTheme.ToColor(entry.Tone)"
                                         Icon="@Icons.Material.Filled.Circle" Class="events__tag">@entry.Category.ToUpperInvariant()</MudChip>
                            </td>
                            <td class="events__msg">
                                @foreach (var part in entry.Parts)
                                {
                                    <span class="@(string.IsNullOrEmpty(part.Style) ? null : $"events__{part.Style}")">@part.Text</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </div>
</div>
