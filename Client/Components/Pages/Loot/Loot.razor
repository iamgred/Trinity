@page "/loot"
@layout WorkspaceLayout
@using Client.Components.Shell
@using Client.Components.UI

<PageTitle>Trinity · Loot</PageTitle>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Square="true" role="status">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <span>@_loadError</span>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="LoadDownloadsAsync">Retry</MudButton>
        </MudStack>
    </MudAlert>
}

<MudToolBar Dense="true" Gutters="true" Class="gap-3 py-2" Style="flex:0 0 auto;">
    <MudSelect T="string" @bind-Value="_agentFilter" Label="Agent" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:180px;">
        <MudSelectItem T="string" Value="@("")">All agents</MudSelectItem>
        @foreach (var id in AgentIds)
        {
            <MudSelectItem T="string" Value="@id">Agent @id</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="string" @bind-Value="_typeFilter" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:180px;">
        <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
        <MudSelectItem T="string" Value="@("Download")">Download</MudSelectItem>
        <MudSelectItem T="string" Value="@("Credential")">Credential</MudSelectItem>
        <MudSelectItem T="string" Value="@("Note")">Note</MudSelectItem>
    </MudSelect>

    <MudSpacer />
    <MudText Typo="Typo.caption" Class="mud-text-secondary">Downloads land here as they arrive · @Filtered.Count() items</MudText>
</MudToolBar>

<div style="flex:1;min-height:0;overflow:auto;">
    <MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Elevation="0" Square="true">
        <thead>
            <tr><th>agent</th><th>type</th><th>name</th><th>path / value</th><th>size</th><th>received</th><th>status</th><th>collected</th></tr>
        </thead>
        <tbody>
            @if (!Filtered.Any())
            {
                <tr><td colspan="8" class="mud-text-secondary" style="text-align:center;">@(_isLoading ? "Loading downloads…" : "Nothing collected yet.")</td></tr>
            }
            @foreach (var item in Filtered)
            {
                <tr class="@(item == _selected ? "t-row-selected" : null)" style="cursor:pointer;" @onclick="() => _selected = item">
                    <td>@(item.AgentId?.ToString() ?? "–")</td>
                    <td>
                        <span class="d-inline-flex align-center gap-2">
                            <MudIcon Icon="@TypeIcon(item.Type)" Size="Size.Small" /> @item.Type
                        </span>
                    </td>
                    <td>@item.Name</td>
                    <td class="@(item.Type == "Credential" ? "mud-text-secondary" : null)">@(item.Type == "Credential" ? "••••••••••" : item.PathOrValue)</td>
                    <td>@(item.Size is null ? "–" : FormatSize(item.Size.Value))</td>
                    <td>
                        @if (item.Type == "Download")
                        {
                            <div class="d-flex align-center gap-2">
                                <MudProgressLinear Value="ProgressPercent(item)" Rounded="true" Size="Size.Small" Style="width:80px;"
                                                   Color="@(item.Status == "complete" ? Color.Success : Color.Primary)" />
                                <span class="mud-text-secondary">@ReceivedLabel(item)</span>
                            </div>
                        }
                        else
                        {
                            <span class="mud-text-secondary">–</span>
                        }
                    </td>
                    <td><StatusPill Text="@item.Status" Tone="@StatusTone(item.Status)" /></td>
                    <td>@item.Collected.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</div>

<ActionBar>
    <MudSpacer />
    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="!CanSave" OnClick="SaveToDiskAsync">Save to Disk</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="!CanCancel" OnClick="CancelDownload">Cancel Download</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ContentCopy" Disabled="_selected is null" OnClick="CopyValueAsync">@(_copyStatus ?? "Copy Value")</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenNote">Add Note</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="_selected is null" OnClick="Remove">Remove</MudButton>
    <MudSpacer />
</ActionBar>

<MudDialog @bind-Visible="_noteOpen" Options="_dialogOptions">
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Outlined.StickyNote2" Title="Add Note" Subtitle="Saved to loot for an agent" />
    </TitleContent>
    <DialogContent>
        <FormRow Label="Agent">
            <MudSelect T="string" @bind-Value="_noteAgent" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var id in AgentIds)
                {
                    <MudSelectItem T="string" Value="@id">Agent @id</MudSelectItem>
                }
            </MudSelect>
        </FormRow>
        <FormRow Label="Title">
            <MudTextField @bind-Value="_noteName" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </FormRow>
        <FormRow Label="Note" Top="true">
            <MudTextField @bind-Value="_noteText" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Lines="3" />
        </FormRow>
        @if (_noteError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" role="alert">@_noteError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <span class="t-dialog-note">Notes stay with the agent's loot.</span>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="() => _noteOpen = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveNote">Add Note</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
}
