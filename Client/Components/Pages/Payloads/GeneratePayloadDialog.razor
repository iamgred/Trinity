@namespace Client.Components.Pages.Dialogs
@using System.Net.Http.Json
@using System.Text.Json
@using Client.Components.UI
@using Client.Services
@using Trinity.Shared.DTOs.Payload
@using Trinity.Shared.Enums
@using Campaign = Trinity.Shared.Models.Campaign
@using Trinity.Shared.Interfaces
@inject ListenerApiClient ListenerApi
@inject CampaignService CampaignService
@inject IPayloadAPI PayloadApi

<TrinityDialog Title="Generate Payload" Subtitle="Build an agent that calls back to a listener" Icon="@Icons.Material.Outlined.Bolt"
               FootNote="Built on the team server and added to Payloads." Error="@_error" OnClose="OnClose">
    <ChildContent>
        <div class="td-row">
            <label for="gp-name">Name</label>
            <MudTextField T="string" @bind-Value="_name" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="gp-name" />
        </div>

        <div class="td-row">
            <label>Listener</label>
            <MudSelect T="int" @bind-Value="_listenerId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                @if (_listeners.Count == 0)
                {
                    <MudSelectItem T="int" Value="0">No listeners running</MudSelectItem>
                }
                @foreach (var listener in _listeners)
                {
                    <MudSelectItem T="int" Value="@listener.id">@listener.name · @listener.protocol.ToUpperInvariant()</MudSelectItem>
                }
            </MudSelect>
        </div>

        <div class="td-row">
            <label>Architecture</label>
            <div>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Outlined.Lock" Class="gp-arch">x64</MudChip>
                <p class="td-hint">Trinity agents are built for x64 only.</p>
            </div>
        </div>

        <div class="td-row">
            <label>Payload Type</label>
            <MudToggleGroup T="string" @bind-Value="_type" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" FixedContent="true">
                @foreach (var type in PayloadTypes)
                {
                    <MudToggleItem T="string" Value="@type">@type</MudToggleItem>
                }
            </MudToggleGroup>
        </div>

        <div class="td-row">
            <label>Campaign</label>
            <MudSelect T="int" @bind-Value="_campaignId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Flag" AdornmentColor="Color.Primary"
                       AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                @if (_campaigns.Count == 0)
                {
                    <MudSelectItem T="int" Value="0">No campaigns</MudSelectItem>
                }
                @foreach (var campaign in _campaigns)
                {
                    <MudSelectItem T="int" Value="@campaign.ID">@campaign.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    </ChildContent>
    <Footer>
        <MudButton Variant="Variant.Outlined" OnClick="OnClose">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="GenerateAsync">@(_busy ? "Generating…" : "Generate")</MudButton>
    </Footer>
</TrinityDialog>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnGenerated { get; set; }

    private static readonly IReadOnlyList<string> PayloadTypes = ["winexe", "dll"];

    private IReadOnlyList<ListenerResponse> _listeners = [];
    private List<Campaign> _campaigns = [];
    private string _name = "agent_x64";
    private int _listenerId;
    private int _campaignId;
    private string _type = "winexe";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _listeners = await ListenerApi.GetListenersAsync();
            _campaigns = await CampaignService.GetTasksAsync();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or JsonException)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not load listeners or campaigns: {e.Message}";
        }

        _listenerId = _listeners.FirstOrDefault()?.id ?? 0;
        _campaignId = _campaigns.FirstOrDefault()?.ID ?? 0;
    }

    private async Task GenerateAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name) || _listenerId == 0 || _campaignId == 0)
        {
            _error = "Enter a name and pick a listener and a campaign.";
            return;
        }

        var request = new PayloadCreationDTO
        {
            Name = _name.Trim(),
            ListenerID = _listenerId,
            CampaignID = _campaignId,
            Architecture = Arch.x64,
            Type = _type == "dll" ? PayloadType.WINDOWS_DLL : PayloadType.WINDOWS_EXE,
        };

        _busy = true;
        try
        {
            await PayloadApi.GenerateAsync(request);
            await OnGenerated.InvokeAsync();
        }
        catch (Refit.ApiException e)
        {
            _error = $"The team server refused the build ({(int)e.StatusCode}).";
        }
        catch (HttpRequestException e)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}