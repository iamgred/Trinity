@using System.Net.Http.Json
@using System.Text.Json
@using Client.Services
@using Trinity.Shared.DTOs.Payload
@using Trinity.Shared.Enums
@using Campaign = Trinity.Shared.Models.Campaign
@inject ListenerApiClient ListenerApi
@inject CampaignService CampaignService
@inject IHttpClientFactory HttpFactory

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Primary" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Generate Payload</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Build an agent that calls back to a listener</MudText>
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Immediate="true" />

            <MudSelect T="int" @bind-Value="_listenerId" Label="Listener" Variant="Variant.Outlined">
                @if (_listeners.Count == 0)
                {
                    <MudSelectItem T="int" Value="0">No listeners running</MudSelectItem>
                }
                @foreach (var listener in _listeners)
                {
                    <MudSelectItem T="int" Value="@listener.id">@listener.name · @listener.protocol.ToUpperInvariant()</MudSelectItem>
                }
            </MudSelect>

            <div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">Architecture</MudText>
                <MudChip T="string" Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="ma-0">x64</MudChip>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">Trinity agents are built for x64 only.</MudText>
            </div>

            <div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">Payload Type</MudText>
                <MudToggleGroup T="PayloadType" @bind-Value="_type" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="true">
                    @foreach (var (type, label) in PayloadTypes)
                    {
                        <MudToggleItem Value="@type" Text="@label" />
                    }
                </MudToggleGroup>
            </div>

            <MudSelect T="int" @bind-Value="_campaignId" Label="Campaign" Variant="Variant.Outlined"
                       Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Flag">
                @if (_campaigns.Count == 0)
                {
                    <MudSelectItem T="int" Value="0">No campaigns</MudSelectItem>
                }
                @foreach (var campaign in _campaigns)
                {
                    <MudSelectItem T="int" Value="@campaign.ID">@campaign.Name</MudSelectItem>
                }
            </MudSelect>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mr-auto ml-2">Built on the team server and added to Payloads.</MudText>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="GenerateAsync">@(_busy ? "Generating…" : "Generate")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private static readonly IReadOnlyList<(PayloadType Type, string Label)> PayloadTypes =
    [
        (PayloadType.WINDOWS_EXE, "winexe"),
        (PayloadType.WINDOWS_DLL, "dll"),
    ];

    private IReadOnlyList<ListenerResponse> _listeners = [];
    private List<Campaign> _campaigns = [];
    private string _name = "agent_x64";
    private int _listenerId;
    private int _campaignId;
    private PayloadType _type = PayloadType.WINDOWS_EXE;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _listeners = await ListenerApi.GetListenersAsync();
            _campaigns = await CampaignService.GetAllAsync();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or JsonException)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not load listeners or campaigns: {e.Message}";
        }

        _listenerId = _listeners.FirstOrDefault()?.id ?? 0;
        _campaignId = _campaigns.FirstOrDefault()?.ID ?? 0;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task GenerateAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name) || _listenerId == 0 || _campaignId == 0)
        {
            _error = "Enter a name and pick a listener and a campaign.";
            return;
        }

        var request = new PayloadCreationDTO
        {
            Name = _name.Trim(),
            ListenerID = _listenerId,
            CampaignID = _campaignId,
            Architecture = Arch.x64,
            Type = _type,
        };

        _busy = true;
        try
        {
            var http = HttpFactory.CreateClient("TeamServer");
            var response = await http.PostAsJsonAsync("/api/v1/payloads/generate", request);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"The team server refused the build ({(int)response.StatusCode}).";
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (HttpRequestException e)
        {
            _error = ServerDown.Is(e) ? ServerDown.Message : $"Could not reach the team server: {e.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
