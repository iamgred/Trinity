@page "/payloads"
@namespace Client.Components.Pages
@rendermode InteractiveServer
@using Client.Components.Shell
@using Client.Components.UI
@using Client.Components.Pages.Dialogs
@using Client.Services
@using System.Text.Json
@using Trinity.Shared.DTOs.Payload
@inject PayloadService PayloadService
@inject NavigationManager Nav

<PageTitle>Trinity · Payloads</PageTitle>

<div class="payloads">
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Square="true" Class="payloads__notice"
                  ContentAlignment="HorizontalAlignment.Left">
            @_loadError
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="LoadAsync">Retry</MudButton>
        </MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
    }

    <div class="payloads__scroll">
        <MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Elevation="0" Square="true" Class="payloads__table">
            <colgroup>
                <col style="width:30%" /><col style="width:17%" /><col style="width:12%" /><col style="width:41%" />
            </colgroup>
            <thead>
                <tr><th>name</th><th>type</th><th>size</th><th>created</th></tr>
            </thead>
            <tbody>
                @if (_payloads.Count == 0)
                {
                    <tr class="payloads__empty"><td colspan="4">@(_loading ? "Loading payloads…" : "No payloads generated yet.")</td></tr>
                }
                @foreach (var payload in _payloads)
                {
                    <tr class="@(payload == _selected ? "is-selected" : null)" @onclick="() => _selected = payload">
                        <td>
                            <span class="payloads__name">
                                <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Class="payloads__file" />
                                @payload.Name
                            </span>
                        </td>
                        <td>@payload.Type</td>
                        <td>@FormatSize(payload.Size)</td>
                        <td>@payload.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>

    <div class="payloads__actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="payloads__generate"
                   StartIcon="@Icons.Material.Outlined.Bolt" OnClick="() => _generateOpen = true">Generate</MudButton>
    </div>
</div>

@if (_generateOpen)
{
    <GeneratePayloadDialog OnClose="CloseGenerate" OnGenerated="OnGeneratedAsync" />
}
