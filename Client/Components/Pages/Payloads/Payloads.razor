@page "/payloads"
@namespace Client.Components.Pages
@rendermode InteractiveServer
@using Client.Components.Shell
@using Client.Components.Pages.Dialogs
@using Client.Services
@using System.Text.Json
@using Trinity.Shared.DTOs.Payload
@inject PayloadService PayloadService
@inject NavigationManager Nav

<PageTitle>Payloads — Trinity C2</PageTitle>

<div class="payload-root">
    <MudPaper Class="armory-card" Elevation="0">
        <div class="card-header">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="card-icon" />
            <MudText Typo="Typo.h6">Armory</MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Add"
                       Color="Color.Warning"
                       Variant="Variant.Filled"
                       OnClick="@(() => _generateOpen = true)">
                Generate
            </MudButton>
            <MudTooltip Text="Refresh"><MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadAsync" /></MudTooltip>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Color="Color.Warning" Indeterminate="true" Class="mb-2" />
        }

        @if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">@_loadError</MudAlert>
        }

        <MudTable Items="@_payloads"
                  Dense="true"
                  Hover="true"
                  Striped="false"
                  Class="armory-table"
                  Elevation="0">
            <HeaderContent>
                <MudTh>Filename</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Size</MudTh>
                <MudTh>Created</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Filename">
                    <MudText Typo="Typo.body2" Class="mono">@context.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                             Variant="Variant.Outlined">@context.Type</MudChip>
                </MudTd>
                <MudTd DataLabel="Size">@FormatSize(context.Size)</MudTd>
                <MudTd DataLabel="Created">@context.CreatedAt.ToString("dd MMM HH:mm")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="no-data">No payloads generated yet.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</div>

@if (_generateOpen)
{
    <GeneratePayloadDialog OnClose="CloseGenerate" OnGenerated="OnGeneratedAsync" />
}