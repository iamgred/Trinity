@page "/payloads"
@layout WorkspaceLayout
@using System.Text.Json
@using Client.Components.Shell
@using Client.Services
@using Trinity.Shared.DTOs.Payload
@inject PayloadService PayloadService
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Trinity · Payloads</PageTitle>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Square="true" role="status">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <span>@_loadError</span>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="LoadAsync">Retry</MudButton>
        </MudStack>
    </MudAlert>
}

<div style="flex:1;min-height:0;overflow:auto;">
    <MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Elevation="0" Square="true">
        <thead>
            <tr><th>name</th><th>type</th><th>listener</th><th>size</th><th>created</th></tr>
        </thead>
        <tbody>
            @if (_payloads.Count == 0)
            {
                <tr><td colspan="5" class="mud-text-secondary" style="text-align:center;">@(_loading ? "Loading payloads…" : "No payloads yet. Use Generate to build one.")</td></tr>
            }
            @foreach (var payload in _payloads)
            {
                <tr class="@(payload == _selected ? "t-row-selected" : null)" style="cursor:pointer;" @onclick="() => _selected = payload">
                    <td>
                        <span class="d-inline-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Small" /> @payload.Name
                        </span>
                    </td>
                    <td>@payload.Type</td>
                    <td class="mud-text-secondary">–</td>
                    <td>@FormatSize(payload.Size)</td>
                    <td>@payload.CreateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</div>

<ActionBar>
    <MudSpacer />
    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Bolt" OnClick="OpenGenerateAsync">Generate</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Save" Disabled="true" title="Needs a payload ID from the API">Save to Disk</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="true" title="The team server has no delete route for payloads yet">Remove</MudButton>
    <MudSpacer />
</ActionBar>

@code {
    [CascadingParameter] private WorkspaceState State { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "generate")]
    public int? GenerateQuery { get; set; }

    private List<PayloadDTO> _payloads = [];
    private PayloadDTO? _selected;
    private string? _loadError;
    private bool _loading;
    private bool _openFromNav;

    protected override async Task OnInitializedAsync()
    {
        State.OpenTab("Payloads", "payloads");
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (GenerateQuery == 1)
        {
            _openFromNav = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_openFromNav)
        {
            _openFromNav = false;
            await OpenGenerateAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _payloads = (await PayloadService.GetAllAsync()).OrderByDescending(p => p.CreateTime).ToList();
            _selected = _payloads.FirstOrDefault();
            _loadError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            _loadError = ServerDown.Is(ex) ? ServerDown.Message : $"Couldn't load the payloads: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenGenerateAsync()
    {
        var dialog = await DialogService.ShowAsync<GeneratePayloadDialog>(string.Empty,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;

        if (GenerateQuery == 1)
        {
            Nav.NavigateTo("payloads", replace: true);
        }

        if (result is { Canceled: false })
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private static string FormatSize(int bytes) => bytes >= 1_048_576 ? $"{bytes / 1_048_576.0:0.0} MB" : $"{Math.Max(1, (int)Math.Round(bytes / 1024.0))} KB";
}
