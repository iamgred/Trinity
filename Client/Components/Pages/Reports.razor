@page "/reports"
@rendermode InteractiveServer
@using MudBlazor
@inject IDialogService DialogService
@using Client.Components.Pages.Dialogs

<style>
    .card  { background-color:#242424; border:1px solid #333; }
    .card-p{ background-color:#242424; border:1px solid #333; padding:16px; }
    .muted { color:#AAAAAA !important; }
    .white { color:white; }
    .lnk   { color:#E87722; text-decoration:none; font-size:0.875rem; }
    .dot   { width:8px;  height:8px;  border-radius:50%; margin-right:6px; }
    .dot-lg{ width:10px; height:10px; border-radius:50%; margin-right:6px; }
    .qa-btn{ text-transform:none !important; justify-content:flex-start !important; }
</style>

<MudText Typo="Typo.h5" Style="color:white; font-weight:700; margin-bottom:4px;">Reports</MudText>
<MudText Typo="Typo.body2" Class="muted" Style="margin-bottom:24px;">View and analyse all reports</MudText>

<!-- Stat Cards -->
<MudGrid Spacing="3" Class="mb-4">
    @foreach (var card in _statCards)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="card" Style="padding:20px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@card.Icon" Style="color:#888; font-size:2.8rem; margin-right:14px;" />
                    <div>
                <MudText Typo="Typo.caption" Class="muted">@card.Label</MudText>
                <MudText Typo="Typo.h4" Style="color:white; font-weight:700;">@card.Value</MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<!-- Main Content -->
<MudGrid Spacing="3">

    <!-- All Reports -->
    <MudItem xs="12" md="8">
        <MudPaper Class="card" Elevation="0">
            <div style="padding:16px 16px 0; display:flex; justify-content:space-between;
                        align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:8px;">
                <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600;">All Reports</MudText>
                <!-- Search and filter controls -->
                <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                    <MudTextField @bind-Value="_search" Placeholder="Search reports..."
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Style="min-width:180px;" />
                    <MudSelect @bind-Value="_filterType" Label="Type" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="min-width:120px;">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        <MudSelectItem Value="@("PDF")">PDF</MudSelectItem>
                        <MudSelectItem Value="@("DOCX")">DOCX</MudSelectItem>
                        <MudSelectItem Value="@("CSV")">CSV</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
            <!-- Reports data table -->
            <MudTable T="ReportModel" Items="@_reports" Dense="true" Hover="true"
                      Elevation="0" Style="background-color:transparent;">
                <HeaderContent>
                    <MudTh Class="muted">Name</MudTh>
                    <MudTh Class="muted">Type</MudTh>
                    <MudTh Class="muted">Generated By</MudTh>
                    <MudTh Class="muted">Date</MudTh>
                    <MudTh Class="muted">Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="white">@context.Name</MudTd>
                    <MudTd Class="muted">@context.Type</MudTd>
                    <MudTd Class="muted">@context.GeneratedBy</MudTd>
                    <MudTd Class="muted">@context.Date</MudTd>
                    <MudTd>
                        <!-- Status badge colour depends on value -->
                        <span style="color:@(context.Status == "Complete" ? "#4CAF50" : "#E87722");
                                     font-size:0.8rem; font-weight:600;">
                            @context.Status
                        </span>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="muted" Style="text-align:center; padding:20px;">No Reports To Display</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>

    <!-- RIGHT COLUMN: Charts -->
    <MudItem xs="12" md="4">
        <MudStack Spacing="3">

            <!-- Reports by type chart -->
            <MudPaper Class="card-p" Elevation="0">
                <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600; margin-bottom:16px;">Reports by Type</MudText>
                @if (_typeData.Any(x => x > 0))
                {
                    <MudChart T="double" ChartType="ChartType.Donut"
                              ChartData="@_typeData" ChartLabels="@_typeLabels"
                              Width="100%" Height="180px" />
                }
                else
                {
                    <div style="width:130px; height:130px; border-radius:50%; border:18px solid #333;
                         display:flex; align-items:center; justify-content:center; margin:0 auto;">
                        <div style="color:#AAA; font-size:0.75rem; text-align:center;">No Data</div>
                    </div>
                }
            </MudPaper>

            <!-- Reoprts by status chart -->
            <MudPaper Class="card-p" Elevation="0">
                <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600; margin-bottom:16px;">Reports by Status</MudText>
                @if (_statusData.Any(x => x > 0))
                {
                    <MudChart T="double" ChartType="ChartType.Donut"
                              ChartData="@_statusData" ChartLabels="@_statusLabels"
                              Width="100%" Height="180px" />
                }
                else
                {
                    <div style="width:130px; height:130px; border-radius:50%; border:18px solid #333;
                         display:flex; align-items:center; justify-content:center; margin:0 auto;">
                        <div style="color:#AAA; font-size:0.75rem; text-align:center;">No Data</div>
                    </div>
                }
            </MudPaper>

        </MudStack>
    </MudItem>

    <!-- Top report generators -->
    <MudItem xs="12" md="8">
        <MudPaper Class="card" Elevation="0">
            <div style="padding:16px 16px 0;">
                <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600;">Top Report Generators</MudText>
            </div>
            <MudTable T="GeneratorModel" Items="@_topGenerators" Dense="true" Hover="true"
                      Elevation="0" Style="background-color:transparent;">
                <HeaderContent>
                    <MudTh Class="muted">Agent</MudTh>
                    <MudTh Class="muted">Reports</MudTh>
                    <MudTh Class="muted">Last Active</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="white">@context.Agent</MudTd>
                    <MudTd Style="color:#E87722; font-size:0.85rem; font-weight:600;">@context.Count</MudTd>
                    <MudTd Class="muted">@context.LastActive</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="muted" Style="text-align:center; padding:20px;">No Data To Display</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>

    <!-- Quick Actions + Recent Reports -->
    <MudItem xs="12" md="4">
        <MudStack Spacing="3">

            <!-- QUICK ACTIONS panel -->
            <MudPaper Class="card-p" Elevation="0">
                <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600; margin-bottom:12px;">Quick Actions</MudText>
                <div class="d-flex flex-column" style="gap:8px;">
                    <!-- Each button opens its respective dialog -->
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateNewReportDialog">Create New Report</MudButton>
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.Schedule"
                               OnClick="OpenScheduleReportDialog">Schedule Report</MudButton>
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.GridView"
                               OnClick="OpenReportTemplatesDialog">Report Templates</MudButton>
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="OpenExportDataDialog">Export Data</MudButton>
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.BarChart"
                               OnClick="OpenViewReportsDialog">View Reports</MudButton>
                </div>
            </MudPaper>

            <!-- RECENT REPORTS list -->
            <MudPaper Class="card-p" Elevation="0">
                <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600; margin-bottom:12px;">Recent Reports</MudText>
                @if (_recentReports.Count == 0)
                {
                    <div style="text-align:center; padding:16px; color:#666; font-size:0.875rem;">No Recent Reports</div>
                }
                else
                {
                    @foreach (var r in _recentReports)
                    {
                        <!-- One row per recent report -->
                        <div style="display:flex; justify-content:space-between; align-items:center;
                                    padding:8px 0; border-bottom:1px solid #333;">
                            <div>
                                <div class="white" style="font-size:0.85rem;">@r.Name</div>
                                <div class="muted" style="font-size:0.75rem;">@r.Date</div>
                            </div>
                            <span class="muted" style="font-size:0.78rem;">@r.Type</span>
                        </div>
                    }
                }
            </MudPaper>

        </MudStack>
    </MudItem>

</MudGrid>

@code {
    //Search / filter
    private string _search     = string.Empty;
    private string _filterType = "All";

    //Stat cards
    private record StatCard(string Label, string Value, string Icon);
    private StatCard[] _statCards =
    {
        new("Total Reports", "0", Icons.Material.Outlined.Description),
        new("Generated Today", "0", Icons.Material.Outlined.Today),
        new("Scheduled", "0", Icons.Material.Outlined.Schedule),
        new("Pending", "0", Icons.Material.Outlined.HourglassEmpty),
    };

    //All-reports table
    private record ReportModel(string Name, string Type, string GeneratedBy, string Date, string Status);
    private List<ReportModel> _reports = new();

    //By type chart
    private double[] _typeData   = { 0, 0, 0, 0 };
    private string[] _typeLabels = { "PDF", "DOCX", "CSV", "Excel" };

    //By status chart
    private double[] _statusData   = { 0, 0, 0 };
    private string[] _statusLabels = { "Complete", "Pending", "Scheduled" };

    //Top generators table
    private record GeneratorModel(string Agent, int Count, string LastActive);
    private List<GeneratorModel> _topGenerators = new();

    //Recent reports list
    private List<ReportModel> _recentReports = new();

    //Shared dialog options
    private static readonly DialogOptions _dialogOpts = new()
    {
        CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true
    };

    //Dialog launchers
    private Task OpenCreateNewReportDialog()
        => DialogService.ShowAsync<CreateNewReportDialog>(string.Empty, new(), _dialogOpts);

    private Task OpenScheduleReportDialog()
        => DialogService.ShowAsync<ScheduleReportDialog>(string.Empty, new(), _dialogOpts);

    private Task OpenReportTemplatesDialog()
        => DialogService.ShowAsync<ReportTemplatesDialog>(string.Empty, new(), _dialogOpts);

    private Task OpenExportDataDialog()
        => DialogService.ShowAsync<ExportDataDialog>(string.Empty, new(), _dialogOpts);

    private Task OpenViewReportsDialog()
        => DialogService.ShowAsync<ViewReportsDialog>(string.Empty, new(), _dialogOpts);
}

