<MudStack Row="true" AlignItems="AlignItems.Center" Class="py-3" Style="border-bottom:1px solid var(--mud-palette-divider);">
    <MudStack Spacing="0" Style="flex:1;">
        <MudText Typo="Typo.body1">@Label</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Description</MudText>
    </MudStack>
    <div style="width:220px;display:flex;justify-content:flex-end;">@ChildContent</div>
</MudStack>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
