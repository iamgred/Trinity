@page "/settings"
@layout TrinityLayout
@using Client.Components.UI

<PageTitle>Trinity · Settings</PageTitle>

<MudAlert Severity="Severity.Info" Class="mb-4" role="status">Settings shown here are UI-only and are not saved to TeamServer.</MudAlert>

<MudStack Spacing="0" Class="mb-4">
    <MudText Typo="Typo.h4" Style="font-weight:700;">Settings</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Configure and manage your system and preferences</MudText>
</MudStack>

<div class="d-flex flex-wrap gap-3 mb-4">
    @foreach (var stat in BuildStats())
    {
        <MudPaper Class="pa-4 d-flex align-center gap-3" Style="flex:1 1 180px;">
            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Rounded="true"><MudIcon Icon="@stat.Icon" /></MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@stat.Label</MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700;">@stat.Value</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@stat.Sub</MudText>
            </MudStack>
        </MudPaper>
    }
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="3" lg="2">
        <MudPaper Class="py-2">
            <MudText Typo="Typo.subtitle1" Class="px-4 py-2" Style="font-weight:600;">Settings Categories</MudText>
            <MudList T="string" SelectedValue="_category" SelectedValueChanged="v => SelectCategory(v!)" Color="Color.Primary" Dense="true">
                @foreach (var c in _categories)
                {
                    <MudListItem T="string" Value="@c" Text="@c" />
                }
            </MudList>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="9" lg="6">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">C2 Framework Settings</MudText>

                <SettingRow Label="Enable C2 Framework" Description="Enable the command and control framework">
                    <MudSwitch T="bool" @bind-Value="_enableC2" Color="Color.Primary" />
                </SettingRow>
                <SettingRow Label="Default C2 Profile" Description="Select the default communication profile">
                    <MudSelect T="string" @bind-Value="_defaultProfile" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem T="string" Value="@("HTTPS Beacon")">HTTPS Beacon</MudSelectItem>
                        <MudSelectItem T="string" Value="@("WebDAV")">WebDAV</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Custom (RAW)")">Custom (RAW)</MudSelectItem>
                    </MudSelect>
                </SettingRow>
                <SettingRow Label="Default Response Profile" Description="Select default response behaviour for new clients">
                    <MudSelect T="string" @bind-Value="_responseProfile" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem T="string" Value="@("Aggressive")">Aggressive</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Balanced")">Balanced</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Stealth")">Stealth</MudSelectItem>
                    </MudSelect>
                </SettingRow>
                <SettingRow Label="Default Sleep (Jitter)" Description="Default sleep interval with jitter">
                    <MudSelect T="string" @bind-Value="_sleepJitter" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem T="string" Value="@("10s (10%)")">10s (10%)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("30s (25%)")">30s (25%)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("60s (50%)")">60s (50%)</MudSelectItem>
                    </MudSelect>
                </SettingRow>
                <SettingRow Label="Max Concurrent Clients" Description="Maximum number of clients allowed">
                    <MudTextField @bind-Value="_maxClients" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </SettingRow>
                <SettingRow Label="Auto Register New Clients" Description="Automatically approve new client registrations">
                    <MudSwitch T="bool" @bind-Value="_autoRegister" Color="Color.Primary" />
                </SettingRow>
                <SettingRow Label="Client Expiry" Description="Automatically remove inactive clients">
                    <MudSelect T="string" @bind-Value="_clientExpiry" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem T="string" Value="@("30 Days")">30 Days</MudSelectItem>
                        <MudSelectItem T="string" Value="@("90 Days")">90 Days</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Never")">Never</MudSelectItem>
                    </MudSelect>
                </SettingRow>
                <SettingRow Label="Kill Date" Description="Date to automatically disable framework">
                    <MudTextField @bind-Value="_killDate" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </SettingRow>
                <SettingRow Label="Log C2 Traffic" Description="Log all command and control traffic">
                    <MudSwitch T="bool" @bind-Value="_logTraffic" Color="Color.Primary" />
                </SettingRow>

                <div class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveChanges">Save Changes</MudButton>
                </div>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Active C2 Channels</MudText>
                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <thead>
                        <tr><th>Profile</th><th>Transport</th><th>Local Address</th><th>Port</th><th>Clients</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ch in _channels)
                        {
                            <tr>
                                <td>@ch.Profile</td>
                                <td>@ch.Transport</td>
                                <td style="font-family:'JetBrains Mono',monospace;">@ch.Local</td>
                                <td style="font-family:'JetBrains Mono',monospace;">@ch.Port</td>
                                <td>@ch.Clients</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                @if (_serverIpV4 is not null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                        TeamServer: <span style="font-family:'JetBrains Mono',monospace;">@_serverIpV4</span>@(string.IsNullOrEmpty(_serverIpV6) ? "" : $" · {_serverIpV6}")
                    </MudText>
                }
                <MudLink Typo="Typo.body2" Class="d-block mt-3" OnClick="@(() => ShowToast("Showing all C2 channels (mock)"))">View all channels →</MudLink>
            </MudPaper>
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">C2 Profiles</MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@(() => ShowToast("Manage C2 profiles (mock)"))">Manage Profiles</MudButton>
                </MudStack>
                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <thead>
                        <tr><th>Profile</th><th>Protocol</th><th>Local Address</th><th>Port</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _profiles)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td>@p.Protocol</td>
                                <td style="font-family:'JetBrains Mono',monospace;">@p.Local</td>
                                <td style="font-family:'JetBrains Mono',monospace;">@p.Port</td>
                                <td><Dot Tone="@p.StatusColor" /> @p.Status</td>
                                <td>
                                    @if (p.Id > 0)
                                    {
                                        <MudTooltip Text="Restart">
                                            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" OnClick="() => RestartProfile(p.Id)" />
                                        </MudTooltip>
                                        <MudTooltip Text="Delete">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteProfile(p.Id)" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <span class="mud-text-secondary">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <MudLink Typo="Typo.body2" Class="d-block mt-3" OnClick="@(() => ShowToast("Showing all C2 profiles (mock)"))">View all C2 profiles →</MudLink>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">AI Agent Behaviour Policies</MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@(() => ShowToast("Manage AI policies (mock)"))">Manage Policies</MudButton>
                </MudStack>
                <MudList T="string" Dense="true" Padding="false">
                    @foreach (var p in _policies)
                    {
                        <MudListItem T="string">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@p.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.Desc</MudText>
                                </MudStack>
                                <MudSpacer />
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="TrinityTheme.ToColor(p.BadgeColor)">@p.Badge</MudChip>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
                <MudLink Typo="Typo.body2" Class="d-block mt-3" OnClick="@(() => ShowToast("Showing all AI policies (mock)"))">View all policies →</MudLink>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">C2 Framework Status</MudText>
                <div class="d-flex justify-center">
                    <div style="position:relative;width:140px;height:140px;">
                        <MudProgressCircular Value="HealthPercent" Color="@(_serverOnline == false ? Color.Error : Color.Success)"
                                             Indeterminate="_serverOnline is null" StrokeWidth="5" Style="width:140px;height:140px;" />
                        <div class="d-flex flex-column align-center justify-center" style="position:absolute;inset:0;">
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@HealthPercent%</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@HealthLabel</MudText>
                        </div>
                    </div>
                </div>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Quick Actions</MudText>
                <MudGrid Spacing="2">
                    @foreach (var a in Actions)
                    {
                        <MudItem xs="6">
                            <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@a.Icon" OnClick="a.OnClick"
                                       Style="justify-content:flex-start;text-transform:none;">@a.Label</MudButton>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

<MudDialog @bind-Visible="_showCreateProfile" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Create New C2 Profile</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_profileName" Label="Profile Name" Placeholder="HTTPS Beacon" Variant="Variant.Outlined" />
            <MudSelect T="string" @bind-Value="_profileProtocol" Label="Protocol" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("HTTP")">HTTP</MudSelectItem>
                <MudSelectItem T="string" Value="@("TCP")">TCP</MudSelectItem>
                <MudSelectItem T="string" Value="@("SMB")">SMB</MudSelectItem>
            </MudSelect>

            @if (_profileProtocol == "SMB")
            {
                <MudTextField @bind-Value="_profilePipe" Label="Pipe Name" Placeholder="trinity-pipe" Variant="Variant.Outlined" />
            }
            else
            {
                @if (_profileProtocol == "HTTP")
                {
                    <MudTextField @bind-Value="_profileHost" Label="Local Address" Placeholder="0.0.0.0" Variant="Variant.Outlined" />
                }
                <MudTextField @bind-Value="_profilePort" Label="Port" Placeholder="8443" Variant="Variant.Outlined" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCreateProfile">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateProfile">Confirm</MudButton>
    </DialogActions>
</MudDialog>
