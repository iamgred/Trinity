@page "/tasks"
@layout TrinityLayout
@using Client.Components.UI

<PageTitle>Trinity · Tasks</PageTitle>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" role="status">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <span>@_loadError</span>
            @if (Connection.BaseAddress is null)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="GoToLogin">Go to Login</MudButton>
            }
            else
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="LoadTasksAsync">Retry</MudButton>
            }
        </MudStack>
    </MudAlert>
}

<MudStack Spacing="0" Class="mb-4">
    <MudText Typo="Typo.h4" Style="font-weight:700;">Tasks</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage and Track all of your Tasks</MudText>
</MudStack>

<div class="d-flex flex-wrap gap-3 mb-4">
    @foreach (var stat in BuildStats())
    {
            <MudPaper Class="pa-4 d-flex align-center gap-3" Style="flex:1 1 180px;">
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Rounded="true"><MudIcon Icon="@stat.Icon" /></MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@stat.Label</MudText>
                    <MudText Typo="Typo.h5" Style="font-weight:700;">@stat.Value</MudText>
                </MudStack>
            </MudPaper>
    }
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" lg="8">
        <MudStack Spacing="3">
            <MudPaper Elevation="1">
                <div class="d-flex flex-wrap align-center gap-3 px-4 pt-4 pb-2">
                    <MudText Typo="Typo.h6" Style="white-space:nowrap;">All Tasks</MudText>
                    <MudSpacer />
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudTextField T="string" Value="_search" ValueChanged="OnSearch" Immediate="true" Placeholder="Search..."
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:200px;" />
                        <MudSelect T="string" Value="_statusFilter" ValueChanged="OnStatusFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:160px;">
                            <MudSelectItem T="string" Value="@("All Status")">All Status</MudSelectItem>
                            @foreach (var status in Statuses)
                            {
                                <MudSelectItem T="string" Value="@status">@status</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTooltip Text="TeamServer does not provide task priority">
                            <MudSelect T="string" Value="@("All Priority")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="true" Style="max-width:140px;">
                                <MudSelectItem T="string" Value="@("All Priority")">All Priority</MudSelectItem>
                            </MudSelect>
                        </MudTooltip>
                        <MudTooltip Text="TeamServer does not provide task assignees">
                            <MudSelect T="string" Value="@("All Assignees")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="true" Style="max-width:150px;">
                                <MudSelectItem T="string" Value="@("All Assignees")">All Assignees</MudSelectItem>
                            </MudSelect>
                        </MudTooltip>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportTasks">Export</MudButton>
                    </MudStack>
                </div>
                <MudTable T="TaskRow" Items="Filtered" Dense="true" Hover="true" RowsPerPage="PageSize" @bind-CurrentPage="_page"
                      Loading="_isLoading" OnRowClick="e => SelectRow(e.Item!)" RowStyleFunc="RowStyle" Elevation="0">
                <HeaderContent>
                    <MudTh>Task Name</MudTh>
                    <MudTh>Agent</MudTh>
                    <MudTh>Campaign</MudTh>
                    <MudTh>Priority</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Assignee</MudTh>
                    <MudTh>Timestamp</MudTh>
                    <MudTh>Progress</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Task Name">@context.Name</MudTd>
                    <MudTd DataLabel="Agent">@context.Client</MudTd>
                    <MudTd DataLabel="Campaign">@context.Campaign</MudTd>
                    <MudTd DataLabel="Priority"><Dot Tone="@PriorityColor(context.Priority)" /> @context.Priority</MudTd>
                    <MudTd DataLabel="Status"><Dot Tone="@StatusColor(context.Status)" /> @context.Status</MudTd>
                    <MudTd DataLabel="Assignee">@context.Assignee</MudTd>
                    <MudTd DataLabel="Timestamp">@context.Timestamp.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Progress">
                        <MudTooltip Text="TeamServer does not provide task progress">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@(_loadError is not null ? "Task records could not be loaded." : "No tasks match your filters.")</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Loading task records...</MudText>
                </LoadingContent>
                <PagerContent>
                    <MudTablePager HideRowsPerPage="true" InfoFormat="Showing {first_item}–{last_item} of {all_items} Tasks" />
                </PagerContent>
            </MudTable>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Upcoming Tasks</MudText>
                @if (_upcoming.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">TeamServer does not provide due dates or upcoming-task data.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var u in _upcoming)
                            {
                                <tr>
                                    <td><Dot Tone="@PriorityColor(u.Priority)" /> @u.Priority</td>
                                    <td>@u.Name</td>
                                    <td>@u.Client</td>
                                    <td>@u.Campaign</td>
                                    <td>@u.Assignee</td>
                                    <td>@u.DueDate</td>
                                    <td><StatusPill Text="@u.Badge" Tone="@u.BadgeColor" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                <MudLink Typo="Typo.body2" Class="d-block mt-3" OnClick="ClearFilters">View All Tasks →</MudLink>
            </MudPaper>
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Task Detail</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Look up a task's command payload by its ID (the task list does not include IDs yet).</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="_detailIdInput" Placeholder="Task ID" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  InputType="InputType.Number" Immediate="true" OnKeyDown="OnDetailKeyDown" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_detailLoading" OnClick="LookupTaskDetailAsync">
                        @(_detailLoading ? "Loading…" : "Look up")
                    </MudButton>
                </MudStack>

                @if (_detailError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" role="alert">@_detailError</MudAlert>
                }
                else if (_detail is not null)
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="mt-3">
                        <tbody>
                            <tr><td class="mud-text-secondary">Task ID</td><td>@_detail.taskID</td></tr>
                            <tr><td class="mud-text-secondary">Agent</td><td>Agent @_detail.agentID</td></tr>
                            <tr><td class="mud-text-secondary">Command Type</td><td>@_detail.commandType</td></tr>
                            <tr><td class="mud-text-secondary">Timestamp</td><td>@_detail.timestamp.ToLocalTime().ToString("g")</td></tr>
                        </tbody>
                    </MudSimpleTable>
                    <MudText Typo="Typo.overline" Class="mud-text-secondary d-block mt-3">Command payload</MudText>
                    <MudPaper Outlined="true" Class="pa-3" Style="overflow:auto;max-height:240px;">
                        <pre style="margin:0;font-family:'JetBrains Mono',monospace;font-size:12px;white-space:pre-wrap;">@FormatCommand(_detail.command)</pre>
                    </MudPaper>
                }
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Tasks by Priority</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudProgressCircular Value="0" Size="Size.Large" Color="Color.Default" StrokeWidth="6" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">—</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary"><Dot Tone="gray" /> Priority data unavailable</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Task Overview</MudText>
                @{ var overview = BuildOverviewBreakdown(); }
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    @if (_tasks.Count > 0)
                    {
                        <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="DonutSeries(overview)" ChartLabels="overview.Select(s => s.Name).ToArray()"
                                  ChartOptions="DonutOptions(overview)" Width="150px" Height="150px">
                            <CustomGraphics>
                                <text x="50%" y="46%" dominant-baseline="middle" text-anchor="middle" fill="white" font-weight="bold" font-size="1.4em">@_tasks.Count</text>
                                <text x="50%" y="60%" dominant-baseline="middle" text-anchor="middle" fill="#AAA" font-size="0.65em">Total</text>
                            </CustomGraphics>
                        </MudChart>
                    }
                    else
                    {
                        <MudProgressCircular Value="0" Size="Size.Large" Color="Color.Default" StrokeWidth="6" />
                    }
                    <MudStack Spacing="1">
                        @foreach (var s in overview)
                        {
                            <MudText Typo="Typo.body2"><Dot Tone="@s.Color" /> @s.Name <span class="mud-text-secondary">@s.Count (@s.Percent%)</span></MudText>
                        }
                        @if (overview.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">No tasks yet.</MudText>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Quick Actions</MudText>
                <MudGrid Spacing="2">
                    @foreach (var a in Actions)
                    {
                        var enabled = a.Label == "View All Tasks";
                        <MudItem xs="6">
                            <MudTooltip Text="@(enabled ? null : "TeamServer does not support this action from the Tasks page.")" RootStyle="width:100%;">
                                <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@a.Icon" Disabled="!enabled" OnClick="a.OnClick"
                                           Style="justify-content:flex-start;text-transform:none;">@a.Label</MudButton>
                            </MudTooltip>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

<MudDialog @bind-Visible="_showCreate" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Create New Task</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Name" Label="Task Name" Placeholder="e.g. Network Recon" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_form.Client" Label="Client" Placeholder="CLIENT-001" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_form.Campaign" Label="Campaign" Placeholder="Security Assessment" Variant="Variant.Outlined" />
            <MudSelect T="string" @bind-Value="_form.Priority" Label="Priority" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("High")">High</MudSelectItem>
                <MudSelectItem T="string" Value="@("Medium")">Medium</MudSelectItem>
                <MudSelectItem T="string" Value="@("Low")">Low</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_form.Assignee" Label="Assignee" Placeholder="Jane Doe" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_form.DueDate" Label="Due Date" Placeholder="31/01/2026" Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseModals">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateTask">Create Task</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showAssign" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Assign Task</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">Task: <strong>@(_selected?.Name ?? "none selected")</strong></MudText>
            <MudTextField @bind-Value="_assignName" Label="Assign to" Placeholder="Operator name" Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseModals">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AssignTask">Assign</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showSchedule" Options="_dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Schedule Task</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">Task: <strong>@(_selected?.Name ?? "none selected")</strong></MudText>
            <MudTextField @bind-Value="_scheduleDate" Label="Run on" Placeholder="31/01/2026 09:00" Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseModals">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ScheduleTask">Schedule</MudButton>
    </DialogActions>
</MudDialog>
