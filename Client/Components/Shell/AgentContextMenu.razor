@using System.Globalization
@using Trinity.Shared.DTOs.Agent

<div style="position:fixed;inset:0;z-index:1300;" @onclick="OnClose" @oncontextmenu="OnClose" @oncontextmenu:preventDefault="true"></div>

<MudPaper Elevation="8" role="menu" Style="@($"position:fixed;left:{Px(X)}px;top:{Px(Y)}px;z-index:1301;min-width:220px;")">
    <MudText Typo="Typo.caption" Class="d-block px-4 pt-2 pb-1 mud-text-secondary">
        agent @Agent.agentID · @Agent.username
    </MudText>
    <MudList T="string" Dense="true">
        <MudListItem T="string" Icon="@Icons.Material.Outlined.Terminal" IconColor="Color.Primary" OnClick="OnInteract"
                     SecondaryText="Enter">Interact</MudListItem>
        <MudDivider />
        <MudListItem T="string" Icon="@Icons.Material.Outlined.List" Disabled="true" SecondaryText="queued tasks"
                     title="Jobs is not in the new shell yet">Jobs</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Outlined.Inventory2" OnClick="OnLoot" SecondaryText="this agent">Loot</MudListItem>
    </MudList>
</MudPaper>

@code {
    [Parameter, EditorRequired] public AgentResponse Agent { get; set; } = default!;
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnInteract { get; set; }
    [Parameter] public EventCallback OnLoot { get; set; }

    private static string Px(double value) => value.ToString("0", CultureInfo.InvariantCulture);
}
