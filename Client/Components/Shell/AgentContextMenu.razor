@using System.Globalization
@using Client.Components.UI
@using Trinity.Shared.DTOs.Agent

<div class="ts-menu-backdrop" @onclick="OnClose" @oncontextmenu="OnClose" @oncontextmenu:preventDefault="true"></div>
<div class="ts-menu" role="menu" style="left:@Px(X)px;top:@Px(Y)px">
    <div class="ts-menu__head">agent @Agent.agentID · @Agent.username</div>
    <button type="button" role="menuitem" class="ts-menu__item is-primary" @onclick="OnInteract">
        <Icon Name="lucide-terminal.svg" Size="14" /> Interact <kbd>Enter</kbd>
    </button>
    <div class="ts-menu__divider"></div>
    @* TODO: Jobs (teammate's screen 08) *@
    <button type="button" role="menuitem" class="ts-menu__item" disabled title="Jobs is not in the new shell yet">
        <Icon Name="lucide-list.svg" Size="14" /> Jobs <kbd>queued tasks</kbd>
    </button>
    <button type="button" role="menuitem" class="ts-menu__item" @onclick="OnLoot">
        <Icon Name="nav-loot.svg" Size="14" /> Loot <kbd>this agent</kbd>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public AgentResponse Agent { get; set; } = default!;
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnInteract { get; set; }
    [Parameter] public EventCallback OnLoot { get; set; }

    private static string Px(double value) => value.ToString("0", CultureInfo.InvariantCulture);
}
