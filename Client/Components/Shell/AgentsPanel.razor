@using Trinity.Shared.DTOs.Agent
@inject NavigationManager Nav

<MudToolBar Dense="true" Gutters="true" Class="gap-3" Style="flex:0 0 auto;min-height:36px;">
    <MudText Typo="Typo.overline" Style="font-weight:700;">AGENTS · @State.Agents.Count</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">Right-click an agent for actions · double-click to interact</MudText>
    <MudSpacer />
    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
        <MudButton StartIcon="@Icons.Material.Filled.TableRows" Color="Color.Primary" Variant="Variant.Filled">Table</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Hub" Disabled="true" title="Pivot Graph is not in the new shell yet">Graph</MudButton>
    </MudButtonGroup>
</MudToolBar>

<MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Elevation="0" Square="true"
                Style="flex:1;min-height:0;overflow:auto;font-family:'JetBrains Mono',monospace;">
    <thead>
        <tr>
            <th>id</th><th>external</th><th>internal</th><th>listener</th><th>user</th><th>process</th>
            <th>pid</th><th>arch</th><th>integrity</th>
            <th>last <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Style="vertical-align:middle;" /></th>
            <th>sleep</th>
        </tr>
    </thead>
    <tbody>
        @if (State.AgentsError is not null)
        {
            <tr><td colspan="11" class="mud-text-secondary" style="text-align:center;">@State.AgentsError</td></tr>
        }
        else if (!State.Agents.Any())
        {
            <tr><td colspan="11" class="mud-text-secondary" style="text-align:center;">No agents have checked in yet.</td></tr>
        }
        else
        {
            @foreach (var agent in State.FilteredAgents)
            {
                var selected = agent.agentID == State.SelectedAgentId;
                var smb = WorkspaceState.IsSmb(agent);
                <tr style="@RowStyle(agent, selected)"
                    @onclick="() => Select(agent)"
                    @ondblclick="() => Interact(agent)"
                    @oncontextmenu="e => OpenMenu(agent, e)" @oncontextmenu:preventDefault="true">
                    <td>
                        <span class="d-inline-flex align-center gap-2" style="@(smb ? "padding-left:14px" : null)">
                            <MudIcon Icon="@(smb ? Icons.Material.Filled.Lan : Icons.Material.Filled.Computer)" Size="Size.Small"
                                     Color="@(smb ? Color.Info : selected ? Color.Primary : Color.Default)" />
                            @agent.agentID
                        </span>
                    </td>
                    <td>@(smb ? "–" : agent.externalIP)</td>
                    <td>@agent.internalIP</td>
                    <td>@agent.listener</td>
                    <td>@agent.username</td>
                    <td>@agent.processName</td>
                    <td>@agent.PID</td>
                    <td>@agent.arch</td>
                    <td class="@(IsHigh(agent) ? "mud-error-text" : null)">@agent.integrity</td>
                    <td>@WorkspaceState.FormatAgo(WorkspaceState.SinceLastCheckIn(agent))</td>
                    <td>@(agent.sleep)s</td>
                </tr>
            }
        }
    </tbody>
</MudSimpleTable>

@if (_menuAgent is not null)
{
    <AgentContextMenu Agent="_menuAgent" X="_menuX" Y="_menuY"
                      OnClose="CloseMenu"
                      OnInteract="() => Interact(_menuAgent)"
                      OnLoot="() => OpenLoot(_menuAgent)" />
}

@code {
    [CascadingParameter] public WorkspaceState State { get; set; } = default!;

    private AgentResponse? _menuAgent;
    private double _menuX;
    private double _menuY;

    private static bool IsHigh(AgentResponse agent) =>
        agent.integrity.Equals("High", StringComparison.OrdinalIgnoreCase) || agent.integrity.Equals("System", StringComparison.OrdinalIgnoreCase);

    private static string RowStyle(AgentResponse agent, bool selected) =>
        "cursor:pointer;" + (selected ? "background:rgba(232,119,34,0.13);" : "") + (WorkspaceState.IsStale(agent) ? "opacity:0.5;" : "");

    private void Select(AgentResponse agent)
    {
        State.SelectedAgentId = agent.agentID;
        State.Notify();
    }

    private void OpenMenu(AgentResponse agent, MouseEventArgs e)
    {
        Select(agent);
        _menuAgent = agent;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
    }

    private void CloseMenu() => _menuAgent = null;

    private void Interact(AgentResponse agent) => Nav.NavigateTo($"agents/{agent.agentID}/interact");

    private void OpenLoot(AgentResponse agent)
    {
        _menuAgent = null;
        Nav.NavigateTo($"loot?agent={agent.agentID}");
    }
}
