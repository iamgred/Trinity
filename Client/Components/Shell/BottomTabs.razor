@inject NavigationManager Nav
@implements IDisposable

<div class="t-tabs" role="tablist">
    @foreach (var tab in State.Tabs)
    {
        var active = IsCurrent(tab.Href);
        <span class="t-tab @(active ? "t-active" : null)" role="tab" aria-selected="@active"
              style="@(State.Tabs.Count > 1 ? null : "padding-right:14px")">
            <a href="@tab.Href">@tab.Title</a>
            @if (State.Tabs.Count > 1)
            {
                <button type="button" class="t-tab-close" aria-label="@($"Close {tab.Title}")" @onclick="() => Close(tab)">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" />
                </button>
            }
        </span>
    }
</div>

@code {
    [CascadingParameter] public WorkspaceState State { get; set; } = default!;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private bool IsCurrent(string href) => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Equals(href, StringComparison.OrdinalIgnoreCase);

    private void Close(ShellTab tab)
    {
        if (State.Tabs.Count == 1)
        {
            return;
        }

        var wasActive = IsCurrent(tab.Href);
        State.Tabs.Remove(tab);
        State.Notify();
        if (wasActive)
        {
            Nav.NavigateTo(State.Tabs[^1].Href);
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
