@inject NavigationManager Nav
@implements IDisposable

<MudPaper Square="true" Elevation="0" Class="d-flex align-center gap-1 px-2"
          Style="flex:0 0 auto;min-height:36px;border-bottom:1px solid var(--mud-palette-divider);background:var(--mud-palette-background-gray);" role="tablist">
    @foreach (var tab in State.Tabs)
    {
        var active = IsCurrent(tab.Href);
        <span class="d-inline-flex align-center" role="tab" aria-selected="@active"
              style="height:24px;border-radius:12px;font-size:0.8125rem;padding:0 @(State.Tabs.Count > 1 ? "2px" : "10px") 0 10px;
                     @(active ? "background:var(--mud-palette-primary);color:var(--mud-palette-primary-text);border:1px solid var(--mud-palette-primary);"
                              : "color:var(--mud-palette-text-primary);border:1px solid var(--mud-palette-lines-inputs);")">
            <a href="@tab.Href" style="color:inherit;text-decoration:none;">@tab.Title</a>
            @if (State.Tabs.Count > 1)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Style="color:inherit;padding:2px;margin-left:2px;"
                               aria-label="@($"Close {tab.Title}")" OnClick="() => Close(tab)" />
            }
        </span>
    }
</MudPaper>

@code {
    [CascadingParameter] public WorkspaceState State { get; set; } = default!;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private bool IsCurrent(string href) => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Equals(href, StringComparison.OrdinalIgnoreCase);

    private void Close(ShellTab tab)
    {
        if (State.Tabs.Count == 1)
        {
            return;
        }

        var wasActive = IsCurrent(tab.Href);
        State.Tabs.Remove(tab);
        State.Notify();
        if (wasActive)
        {
            Nav.NavigateTo(State.Tabs[^1].Href);
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
