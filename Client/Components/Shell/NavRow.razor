@inject NavigationManager Nav
@implements IDisposable

<nav class="t-nav">
    @Item("Listeners", Icons.Material.Outlined.Headset, null)
    @Item("Pivot Graph", Icons.Material.Outlined.Share, null)
    @Item("Agents", Icons.Material.Outlined.TableChart, null)
    <span class="t-sep"></span>
    @Item("Event Log", Icons.Material.Outlined.MonitorHeart, "logs")
    @Item("Loot", Icons.Material.Outlined.Inventory2, "loot")
    @Item("Armoury", Icons.Material.Outlined.ViewInAr, "armoury")
    <span class="t-sep"></span>
    <MudButton Href="payloads?generate=1" Size="Size.Small" Variant="Variant.Text" DropShadow="false"
               Class="@($"t-nav-item t-generate {(IsCurrent("payloads") ? "t-active" : null)}")"
               StartIcon="@Icons.Material.Outlined.Bolt">Generate Payload</MudButton>

    <MudSpacer />

    <MudTextField T="string" Value="State.Filter" ValueChanged="OnFilter" Immediate="true" Class="t-filter"
                  Placeholder="Filter agents by host, user, id…" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" IconSize="Size.Small" />
</nav>

@code {
    [CascadingParameter] public WorkspaceState State { get; set; } = default!;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private bool IsCurrent(string href) => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Equals(href, StringComparison.OrdinalIgnoreCase);

    private RenderFragment Item(string label, string icon, string? href) => __builder =>
    {
        if (href is null)
        {
            <MudTooltip Text="@($"{label} is not in the new shell yet")">
                <MudButton Size="Size.Small" Disabled="true" Class="t-nav-item" StartIcon="@icon">@label</MudButton>
            </MudTooltip>
        }
        else
        {
            <MudButton Href="@href" Size="Size.Small" Variant="Variant.Text" StartIcon="@icon"
                       Class="@($"t-nav-item {(IsCurrent(href) ? "t-active" : null)}")">@label</MudButton>
        }
    };

    private void OnFilter(string? value)
    {
        State.Filter = value ?? "";
        State.Notify();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
