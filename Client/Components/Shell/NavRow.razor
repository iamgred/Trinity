@inject NavigationManager Nav
@implements IDisposable

<MudPaper Square="true" Elevation="0" Style="border-bottom:1px solid var(--mud-palette-divider);background:var(--mud-palette-background-gray);">
    <MudToolBar Dense="true" Gutters="true" Class="gap-1">
        @Item("Listeners", Icons.Material.Filled.Sensors, null)
        @Item("Pivot Graph", Icons.Material.Filled.AccountTree, null)
        @Item("Agents", Icons.Material.Filled.Devices, null)
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
        @Item("Event Log", Icons.Material.Filled.EventNote, "logs")
        @Item("Loot", Icons.Material.Filled.Inventory2, "loot")
        @Item("Armoury", Icons.Material.Filled.Shield, "armoury")
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
        <MudButton Href="payloads?generate=1" Size="Size.Small" Color="Color.Primary"
                   Variant="@(IsCurrent("payloads") ? Variant.Filled : Variant.Outlined)"
                   StartIcon="@Icons.Material.Filled.Build" Style="text-transform:none;white-space:nowrap;">Generate Payload</MudButton>

        <MudSpacer />

        <MudTextField T="string" Value="State.Filter" ValueChanged="OnFilter" Immediate="true"
                      Placeholder="Filter agents by host, user, id…" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                      Style="max-width:320px;" />
    </MudToolBar>
</MudPaper>

@code {
    [CascadingParameter] public WorkspaceState State { get; set; } = default!;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private bool IsCurrent(string href) => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Equals(href, StringComparison.OrdinalIgnoreCase);

    private RenderFragment Item(string label, string icon, string? href) => __builder =>
    {
        if (href is null)
        {
            <MudTooltip Text="@($"{label} is not in the new shell yet")">
                <MudButton Size="Size.Small" Disabled="true" StartIcon="@icon" Style="text-transform:none;white-space:nowrap;">@label</MudButton>
            </MudTooltip>
        }
        else
        {
            var active = IsCurrent(href);
            <MudButton Href="@href" Size="Size.Small" StartIcon="@icon" Style="text-transform:none;white-space:nowrap;"
                       Color="@(active ? Color.Primary : Color.Default)" Variant="@(active ? Variant.Filled : Variant.Text)">@label</MudButton>
        }
    };

    private void OnFilter(string? value)
    {
        State.Filter = value ?? "";
        State.Notify();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
