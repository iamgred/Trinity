<div class="t-statusbar">
    <span class="d-inline-flex align-center gap-2">
        <span class="t-dot" style="background:@(Connected ? "#35C759" : "#E5484D")"></span>
        @(Connected ? "Connected" : "Disconnected")
    </span>
    @foreach (var item in Items)
    {
        <span>@item</span>
    }
    <span class="ml-auto">Trinity C2 · v2.0</span>
</div>

@code {
    [Parameter] public bool Connected { get; set; }
    [Parameter] public IEnumerable<string> Items { get; set; } = [];
}
