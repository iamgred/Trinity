@using Client.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage Session
@inject TeamServerConnection Connection
@inject NavigationManager Nav

<MudAppBar Fixed="false" Dense="true" Elevation="0" Style="border-bottom:1px solid var(--mud-palette-divider);">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <img src="img/shell/shell-logo.png" alt="" width="20" height="20" />
        <MudText Typo="Typo.subtitle1" Style="font-weight:800;letter-spacing:0.12em;">TRINITY</MudText>
    </MudStack>

    @if (Admin)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ml-3">ADMIN CONSOLE</MudChip>
    }

    <MudButton Size="Size.Small" Color="Color.Inherit" Class="ml-3" Style="text-transform:none;">Help</MudButton>

    <MudSpacer />

    @if (Admin)
    {
        <MudButton Href="logs" Size="Size.Small" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ArrowBack" Style="text-transform:none;">Back to workspace</MudButton>
    }
    else
    {
        <MudTooltip Text="@(Connected ? "Team server reachable" : "Team server not reachable")">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Circle"
                     IconColor="@(Connected ? Color.Success : Color.Error)" Style="font-family:'JetBrains Mono',monospace;">@ServerLabel</MudChip>
        </MudTooltip>
    }

    @if (_user is not null)
    {
        @if (_user.IsAdmin && !Admin)
        {
            <MudTooltip Text="Open the admin console">
                <MudButton Href="campaigns" Size="Size.Small" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Person" Style="text-transform:none;">
                    <b>@_user.Name</b>&nbsp;<span class="mud-text-secondary">@_user.Role</span>
                </MudButton>
            </MudTooltip>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mx-2">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                <MudText Typo="Typo.body2"><b>@_user.Name</b> <span class="mud-text-secondary">@_user.Role</span></MudText>
            </MudStack>
        }
    }

    <MudTooltip Text="Sign out">
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Color="Color.Inherit" OnClick="SignOutAsync" />
    </MudTooltip>
</MudAppBar>

@code {
    [Parameter] public bool Admin { get; set; }
    [Parameter] public bool Connected { get; set; }
    [Parameter] public EventCallback<ShellUser> OnUserLoaded { get; set; }

    private ShellUser? _user;

    private string ServerLabel => Connection.BaseAddress is { } uri ? $"teamserver {uri.Host}:{uri.Port}" : "teamserver not set";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var stored = await Session.GetAsync<ShellUser>(ShellUser.StorageKey);
            _user = stored.Success ? stored.Value : null;
        }
        catch (Exception)
        {
            _user = null;
        }

        if (_user is null)
        {
            Nav.NavigateTo("login");
            return;
        }

        if (Admin && !_user.IsAdmin)
        {
            Nav.NavigateTo("logs");
            return;
        }

        StateHasChanged();
        await OnUserLoaded.InvokeAsync(_user);
    }

    private async Task SignOutAsync()
    {
        await Session.DeleteAsync(ShellUser.StorageKey);
        Nav.NavigateTo("login");
    }
}
