@using Client.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage Session
@inject TeamServerConnection Connection
@inject NavigationManager Nav

<MudAppBar Fixed="false" Dense="true" Elevation="0">
    <span class="d-inline-flex align-center gap-2">
        <span class="t-logo"><img src="img/shell/shell-logo.png" alt="" width="18" height="18" /></span>
        <span class="t-brand">TRINITY</span>
    </span>

    @if (Admin)
    {
        <span class="t-admin-badge ml-6">ADMIN CONSOLE</span>
    }

    <span class="t-topbar-link @(Admin ? "ml-5" : "ml-6")">Help</span>

    <MudSpacer />

    @if (Admin)
    {
        <MudButton Href="logs" Size="Size.Small" Class="t-topbar-btn mr-4" StartIcon="@Icons.Material.Outlined.ArrowBack">Back to workspace</MudButton>
    }
    else
    {
        <MudTooltip Text="@(Connected ? "Team server reachable" : "Team server not reachable")">
            <span class="t-server-pill mr-4 @(Connected ? null : "t-down")"><span class="t-dot"></span>@ServerLabel</span>
        </MudTooltip>
    }

    @if (_user is not null)
    {
        @if (_user.IsAdmin && !Admin)
        {
            <MudTooltip Text="Open the admin console">
                <a href="campaigns" class="t-user mr-3">
                    <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Style="font-size:16px;" />
                    <b>@_user.Name</b><span class="t-role">@_user.Role</span>
                </a>
            </MudTooltip>
        }
        else
        {
            <span class="t-user mr-3">
                <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Style="font-size:16px;" />
                <b>@_user.Name</b><span class="t-role">@_user.Role</span>
            </span>
        }
    }

    <MudTooltip Text="Sign out">
        <MudIconButton Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" Color="Color.Inherit" Style="padding:4px;" OnClick="SignOutAsync" />
    </MudTooltip>
</MudAppBar>

@code {
    [Parameter] public bool Admin { get; set; }
    [Parameter] public bool Connected { get; set; }
    [Parameter] public EventCallback<ShellUser> OnUserLoaded { get; set; }

    private ShellUser? _user;

    private string ServerLabel => Connection.BaseAddress is { } uri ? $"teamserver {uri.Host}:{uri.Port}" : "teamserver not set";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var stored = await Session.GetAsync<ShellUser>(ShellUser.StorageKey);
            _user = stored.Success ? stored.Value : null;
        }
        catch (Exception)
        {
            _user = null;
        }

        if (_user is null)
        {
            Nav.NavigateTo("login");
            return;
        }

        if (Admin && !_user.IsAdmin)
        {
            Nav.NavigateTo("logs");
            return;
        }

        StateHasChanged();
        await OnUserLoaded.InvokeAsync(_user);
    }

    private async Task SignOutAsync()
    {
        await Session.DeleteAsync(ShellUser.StorageKey);
        Nav.NavigateTo("login");
    }
}
