@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using Client.Interpreter
@using Client.Services
@using Trinity.Shared.DTOs.Notification
@implements IAsyncDisposable

@inject CommandInterpreter Interpreter
@inject IConfiguration Config
@inject IJSRuntime JS

<div class="term-panel">
    <div class="term-header">
        <div class="term-title">
            <span class="term-icon">❯</span>
            <span>Agent @AgentId</span>
            <span class="term-status @(_connected ? "term-status--on" : "term-status--off")">
                @(_connected ? "connected" : "disconnected")
            </span>
        </div>
        <div style="display:flex;align-items:center;gap:4px;">
            <button class="term-clear-btn" title="Clear (Ctrl+L)" @onclick="ClearOutput">⌫</button>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="term-close-btn" OnClick="OnClose" />
        </div>
    </div>

    <div class="term-output" id="term-output-@AgentId">
        @foreach (var line in _outputs)
        {
            <div class="term-line">@((MarkupString)line)</div>
        }
    </div>

    <div class="term-input-row">
        <span class="term-prompt">❯</span>
        <input class="term-input"
               @ref="_inputRef"
               @bind="_inputText"
               @bind:event="oninput"
               @onkeydown="OnKeyDownAsync"
               placeholder="shell whoami"
               disabled="@(!_connected || _sending)"
               autocomplete="off"
               spellcheck="false" />
        <MudIconButton Icon="@Icons.Material.Filled.Send"
                       Size="Size.Small"
                       Class="term-send-btn"
                       Disabled="@(!_connected || _sending)"
                       OnClick="SendAsync" />
    </div>
</div>

@code {
    [Parameter] public int AgentId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private HubConnection?    _hub;
    private List<string>      _outputs     = [];
    private List<string>      _history     = [];
    private int               _historyIdx  = -1;
    private string            _draftInput  = string.Empty;
    private string            _inputText   = string.Empty;
    private bool              _sending;
    private bool              _connected;
    private bool              _needsScroll;
    private ElementReference  _inputRef;

    protected override async Task OnInitializedAsync()
    {
        string baseUrl = Config["TeamServer:BaseUrl"]!;
        _hub = new HubConnectionBuilder()
            .WithUrl($"{baseUrl}/register")
            .WithAutomaticReconnect()
            .Build();

        _hub.On<TaskNotification>("TaskNotification", async n =>
        {
            Append($"<span class='term-out'><span class='term-task-id'>[#{n.TaskID}]</span> {System.Net.WebUtility.HtmlEncode(n.message)}</span>");
            await InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += async _ =>
        {
            _connected = true;
            await _hub.InvokeAsync("SubscribeToAgent", AgentId.ToString());
            await InvokeAsync(StateHasChanged);
        };

        _hub.Reconnecting += _ =>
        {
            _connected = false;
            return InvokeAsync(StateHasChanged);
        };

        try
        {
            await _hub.StartAsync();
            await _hub.InvokeAsync("SubscribeToAgent", AgentId.ToString());
            _connected = true;
            Append("<span class='term-info'>[+] subscribed to agent notifications</span>");
        }
        catch (Exception ex)
        {
            Append($"<span class='term-err'>[-] {System.Net.WebUtility.HtmlEncode(ex.Message)}</span>");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsScroll)
        {
            _needsScroll = false;
            await JS.InvokeVoidAsync("trinityResize.scrollTerm", $"term-output-{AgentId}");
        }
    }

    private void Append(string html)
    {
        _outputs.Add(html);
        _needsScroll = true;
    }

    private void ClearOutput()
    {
        _outputs.Clear();
        StateHasChanged();
    }

    private async Task SendAsync()
    {
        string input = _inputText.Trim();
        if (string.IsNullOrEmpty(input)) return;

        _inputText   = string.Empty;
        _historyIdx  = -1;
        _draftInput  = string.Empty;
        if (_history.Count == 0 || _history[^1] != input)
            _history.Add(input);

        Append($"<span class='term-cmd'>❯ {System.Net.WebUtility.HtmlEncode(input)}</span>");
        _sending = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await Interpreter.Interpret(AgentId, input);
            Append(result.IsSuccess
                ? $"<span class='term-ok'>[+] {System.Net.WebUtility.HtmlEncode(result.Response ?? string.Empty)}</span>"
                : $"<span class='term-err'>[-] {System.Net.WebUtility.HtmlEncode(result.Error.Description)}</span>");
        }
        catch (Exception ex)
        {
            Append($"<span class='term-err'>[!] {System.Net.WebUtility.HtmlEncode(ex.Message)}</span>");
        }
        finally
        {
            _sending = false;
            StateHasChanged();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await SendAsync();
                break;

            case "ArrowUp":
                if (_history.Count == 0) break;
                if (_historyIdx == -1) _draftInput = _inputText;
                _historyIdx = Math.Min(_historyIdx + 1, _history.Count - 1);
                _inputText  = _history[_history.Count - 1 - _historyIdx];
                break;

            case "ArrowDown":
                if (_historyIdx <= 0) { _historyIdx = -1; _inputText = _draftInput; break; }
                _historyIdx--;
                _inputText = _history[_history.Count - 1 - _historyIdx];
                break;

            case "l" when e.CtrlKey:
                ClearOutput();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            if (_hub.State == HubConnectionState.Connected)
                await _hub.InvokeAsync("UnsubscribeFromAgent", AgentId.ToString());
            await _hub.DisposeAsync();
        }
    }
}
