# Tor's local SOCKS5 listener. The Docker network allows the socks-proxy
# container to connect here; this is not published to the host by Compose.
SocksPort 0.0.0.0:9050
# Keep Tor state in the named volume so the onion identity survives restarts.
DataDirectory /var/lib/tor
# The hostname file is shared read-only with the redirector.
HiddenServiceDir /var/lib/tor/weather_api_hidden_service/
# Public onion port 80 is relayed to the local socat bridge. The bridge then
# forwards to weather-api:8080 because Tor cannot directly resolve that
# Compose service from its loopback target.
HiddenServicePort 80 127.0.0.1:18080
# Emit operational connection errors through the container log.
Log notice stdout